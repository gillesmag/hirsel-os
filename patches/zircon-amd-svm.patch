+/// Guard holding preemption and interrupts disabled around one SVM VCPU entry/exit cycle.
+pub struct AutoSvmGuard {
+    valid: bool,
+    int_state: InterruptSavedState,
+    preempt: Option<AutoPreemptDisabler>,
+}
+
+impl AutoSvmGuard {
+    /// Disables preemption and interrupts for SVM entry.
+    pub fn new() -> Self {
+        let preempt = AutoPreemptDisabler::new();
+        let int_state = arch_interrupt_save();
+        set_blocking_disallowed(true);
+        Self { valid: true, int_state, preempt: Some(preempt) }
+    }
+
+    /// Re-enables interrupts and preemption early (e.g., before blocking on a page fault or HLT).
+    pub fn invalidate(&mut self) {
+        if self.valid {
+            self.valid = false;
+            set_blocking_disallowed(false);
+            arch_interrupt_restore(self.int_state);
+            self.preempt = None;
+        }
+    }
+
+    /// Temporarily opens a single-instruction interrupt window (`sti; nop; cli`) while
+    /// keeping preemption disabled so any pending external LAPIC interrupt is dispatched
+    /// and EOI'd before `AutoPreemptDisabler` flushes preemption.
+    pub fn service_pending_external_interrupt(&self) {
+        debug_assert!(self.valid);
+        debug_assert!(ints_disabled());
+        set_blocking_disallowed(false);
+        // SAFETY: Preemption is disabled via `self.preempt`; briefly enabling interrupts
+        // delivers the pending external interrupt through the kernel IDT and returns with
+        // interrupts disabled again.
+        unsafe {
+            asm!("sti", "nop", "nop", "cli", options(nomem, nostack));
+        }
+        set_blocking_disallowed(true);
+    }
+}
+
+impl Drop for AutoSvmGuard {
+    fn drop(&mut self) {
+        self.invalidate();
+    }
+}
