+fn advance_rip(vmcb: &mut Vmcb, fallback_len: u64) {
+    if vmcb.control.next_rip > vmcb.save.rip {
+        vmcb.save.rip = vmcb.control.next_rip;
+    } else {
+        vmcb.save.rip = vmcb.save.rip.wrapping_add(fallback_len);
+    }
+}
+
+fn exception_has_error_code(vector: u32) -> bool {
+    matches!(
+        vector as u8,
+        v if v == X86_INT_DOUBLE_FAULT.0
+            || v == X86_INT_INVALID_TSS.0
+            || v == X86_INT_SEGMENT_NOT_PRESENT.0
+            || v == X86_INT_STACK_FAULT.0
+            || v == X86_INT_GP_FAULT.0
+            || v == X86_INT_PAGE_FAULT.0
+            || v == X86_INT_ALIGNMENT_CHECK.0
+    )
+}
+
+fn svm_issue_event(vmcb: &mut Vmcb, vector: u32) {
+    let mut inj = u64::from(vector & 0xff) | EVENT_INJ_VALID;
+    if vector == X86_INT_NMI.0 as u32 {
+        inj |= EVENT_INJ_TYPE_NMI;
+    } else if vector <= X86_INT_VIRT.0 as u32 {
+        inj |= EVENT_INJ_TYPE_EXCEPTION;
+        if exception_has_error_code(vector) {
+            inj |= EVENT_INJ_EV;
+        }
+    } else {
+        inj |= EVENT_INJ_TYPE_INTR;
+    }
+    vmcb.control.event_inj = inj;
+}
