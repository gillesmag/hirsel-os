+fn set_packet<T: Copy>(packet: &mut zx_port_packet_t, value: T) {
+    const { assert!(size_of::<T>() <= size_of::<[u8; 32]>()) };
+    // SAFETY: `T` is `Copy` and fits within `packet.union` (32 bytes).
+    unsafe {
+        core::ptr::copy_nonoverlapping(
+            core::ptr::from_ref(&value).cast::<u8>(),
+            packet.union.as_mut_ptr(),
+            size_of::<T>(),
+        );
+    }
+}
