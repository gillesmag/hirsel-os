+//! Per-CPU AMD SVM state: enabling SVM (`EFER.SVME` + `VM_HSAVE_PA`) on every
+//! CPU while any SVM guest exists, plus host `VMSAVE`/`VMLOAD` pages and
+//! contiguous bitmap pages (IOPM / MSRPM).
+
+use core::arch::x86_64::__cpuid;
+use core::pin::Pin;
+use core::ptr;
+use core::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+use debug::dprintf;
+use ksync::{KCell, KMutex};
+use lazy_init::{LazyInit, NoCheck};
+use pin_init::{pin_init, stack_pin_init};
+use zx_status::Status;
+
+use crate::arch_rs::max_num_cpus;
+use crate::arch_rs::x86::feature::{X86_FEATURE_SVM, x86_feature_test};
+use crate::arch_rs::x86::registers::{
+    X86_EFER_SVME, X86_MSR_AMD_VM_CR, X86_MSR_AMD_VM_HSAVE_PA, X86_MSR_IA32_EFER,
+};
+use crate::arch_rs::x86::x86::{read_msr, write_msr};
+use crate::hypervisor::cpu::percpu_exec;
+use crate::hypervisor::page::Page;
+use crate::kernel::mp::{self, MpIpiTarget, cpu_num_t, sync_exec};
+use crate::kernel::types::PAddr;
+use crate::ksync_kernel::TrackedMutex;
+use crate::vm::page::VmPageDoublyLinkedList;
+use crate::vm::{physmap, pmm};
+
+/// `VM_CR.SVMDIS` (bit 4): when set, SVM is disabled by BIOS/firmware.
+const VM_CR_SVMDIS: u64 = 1 << 4;
+
+/// SVM capability summary read from `CPUID 0x8000_000A`.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct SvmInfo {
+    pub revision: u8,
+    pub nasid: u32,
+    pub npt: bool,
+    pub nrips: bool,
+    pub flush_by_asid: bool,
+    pub decode_assists: bool,
+}
+
+impl SvmInfo {
+    /// Reads SVM capabilities from `CPUID 0x8000_000A`.
+    ///
+    /// # Safety
+    ///
+    /// The current CPU must support SVM (`X86_FEATURE_SVM`).
+    pub unsafe fn new() -> Self {
+        let leaf = __cpuid(0x8000_000a);
+        Self {
+            revision: (leaf.eax & 0xff) as u8,
+            nasid: leaf.ebx,
+            npt: (leaf.edx & (1 << 0)) != 0,
+            nrips: (leaf.edx & (1 << 3)) != 0,
+            flush_by_asid: (leaf.edx & (1 << 6)) != 0,
+            decode_assists: (leaf.edx & (1 << 7)) != 0,
+        }
+    }
+}
+
+/// Contiguous wired physical pages for SVM IOPM (3 pages = 12 KiB) or MSRPM (2 pages = 8 KiB).
+pub struct SvmContiguousPages {
+    pa: PAddr,
+    count: usize,
+}
+
+// SAFETY: `SvmContiguousPages` uniquely owns its contiguous physical pages.
+unsafe impl Send for SvmContiguousPages {}
+// SAFETY: Shared references only inspect `pa` and `count`.
+unsafe impl Sync for SvmContiguousPages {}
+
+impl Default for SvmContiguousPages {
+    fn default() -> Self {
+        Self { pa: PAddr(0), count: 0 }
+    }
+}
+
+impl SvmContiguousPages {
+    pub fn alloc(&mut self, count: usize, fill: u8) -> Result<(), Status> {
+        assert_eq!(self.pa.0, 0);
+        stack_pin_init!(let list = VmPageDoublyLinkedList::new());
+        let pa = pmm::alloc_contiguous(count, 0, page::SHIFT as u8, list.as_mut())?;
+        assert!(pa.0 != 0);
+
+        // Detach each page from the temporary list (pages remain tracked by `self.pa` / `self.count`).
+        while list.as_mut().pop_front().is_some() {}
+
+        self.pa = pa;
+        self.count = count;
+        // SAFETY: The `count * page::SIZE` bytes starting at `pa` are mapped in the physmap
+        // and exclusively owned by `self`.
+        unsafe {
+            ptr::write_bytes(self.virtual_address::<u8>(), fill, count * page::SIZE);
+        }
+        Ok(())
+    }
+
+    #[inline]
+    pub fn physical_address(&self) -> PAddr {
+        self.pa
+    }
+
+    #[inline]
+    pub fn virtual_address<T>(&self) -> *mut T {
+        debug_assert!(self.pa.0 != 0);
+        physmap::paddr_to_physmap_mut(self.pa)
+    }
+
+    #[inline]
+    pub fn is_allocated(&self) -> bool {
+        self.pa.0 != 0
+    }
+}
+
+impl Drop for SvmContiguousPages {
+    fn drop(&mut self) {
+        if self.pa.0 != 0 {
+            for i in 0..self.count {
+                let pa = PAddr(self.pa.0 + i * page::SIZE);
+                if let Some(page_ptr) = pmm::paddr_to_vm_page(pa) {
+                    // SAFETY: We exclusively own every page in `[self.pa, self.pa + count * SIZE)`.
+                    unsafe { pmm::free_page(page_ptr) };
+                }
+            }
+            self.pa = PAddr(0);
+            self.count = 0;
+        }
+    }
+}
+
+/// Clears the 2-bit read+write intercept bits for `msr` in an 8 KiB SVM MSRPM.
+///
+/// AMD64 APM Vol 2, §15.11:
+/// - `0x0000_0000..=0x0000_1FFF` -> byte offset `0x0000..0x0800`
+/// - `0xC000_0000..=0xC000_1FFF` -> byte offset `0x0800..0x1000`
+/// - `0xC001_0000..=0xC001_1FFF` -> byte offset `0x1000..0x1800`
+///
+/// Two bits per MSR: bit `2*n` = RDMSR intercept, bit `2*n + 1` = WRMSR intercept.
+///
+/// # Safety
+///
+/// `msrpm` must point to an exclusively owned 8 KiB SVM MSRPM allocation.
+pub unsafe fn svm_ignore_msr(msrpm: *mut u8, msr: u32) {
+    let (base_off, idx) = if msr <= 0x0000_1fff {
+        (0x0000usize, msr as usize)
+    } else if (0xc000_0000..=0xc000_1fff).contains(&msr) {
+        (0x0800usize, (msr - 0xc000_0000) as usize)
+    } else if (0xc001_0000..=0xc001_1fff).contains(&msr) {
+        (0x1000usize, (msr - 0xc001_0000) as usize)
+    } else {
+        return;
+    };
+    let byte_off = base_off + (idx / 4);
+    let bit_shift = (idx % 4) * 2;
+    // SAFETY: `byte_off < 0x1800 < 0x2000` and `msrpm` is 8 KiB.
+    unsafe {
+        *msrpm.add(byte_off) &= !(0b11u8 << bit_shift);
+    }
+}
+
+struct PerCpuSvmPages {
+    hsave: fbl::Array<Page>,
+    host_vmcb: fbl::Array<Page>,
+}
+
+// SAFETY: `PerCpuSvmPages` uniquely owns its `Page`s, which are `Send + Sync`.
+unsafe impl Send for PerCpuSvmPages {}
+unsafe impl Sync for PerCpuSvmPages {}
+
+#[ksync::guarded]
+struct SvmGlobalState {
+    #[mutex]
+    lock: KMutex<TrackedMutex>,
+    #[guarded_by(lock)]
+    pages: PerCpuSvmPages,
+}
+
+static SVM_GLOBAL_STATE: LazyInit<SvmGlobalState, NoCheck> = LazyInit::uninit();
+static NUM_SVM_GUESTS: AtomicUsize = AtomicUsize::new(0);
+static SVM_TLB_GEN: AtomicU64 = AtomicU64::new(1);
+
+// Host VMCB physical addresses indexed by CPU number, published while `NUM_SVM_GUESTS > 0`.
+static HOST_VMCB_PAS: [AtomicU64; 256] = [const { AtomicU64::new(0) }; 256];
+
+fn init_svm_cpu_state(_level: init::LkInitLevel) {
+    // SAFETY: Runs once on the boot CPU before any guest can be created.
+    unsafe {
+        let Ok(()) = Pin::static_ref(&SVM_GLOBAL_STATE).init_pin(pin_init!(SvmGlobalState {
+            lock <- KMutex::init(),
+            pages: KCell::new(PerCpuSvmPages {
+                hsave: fbl::Array::new(),
+                host_vmcb: fbl::Array::new(),
+            }),
+        }));
+    }
+}
+
+init::lk_init_hook!(x86_svm_cpu_state, init_svm_cpu_state, init::LK_INIT_LEVEL_KERNEL);
+
+/// Enables SVM on the current CPU (`EFER.SVME` + `MSR_VM_HSAVE_PA`).
+unsafe fn svm_on_task(hsave_pages: &fbl::Array<Page>, cpu_num: cpu_num_t) -> Result<(), Status> {
+    let info = unsafe { SvmInfo::new() };
+    if !info.npt || info.nasid < 2 {
+        dprintf!(
+            CRITICAL,
+            "hypervisor: AMD SVM missing NPT ({}) or ASIDs ({})\n",
+            info.npt,
+            info.nasid
+        );
+        return Err(Status::NOT_SUPPORTED);
+    }
+
+    let vm_cr = unsafe { read_msr(X86_MSR_AMD_VM_CR) };
+    if (vm_cr & VM_CR_SVMDIS) != 0 {
+        dprintf!(CRITICAL, "hypervisor: AMD SVM disabled by VM_CR.SVMDIS\n");
+        return Err(Status::NOT_SUPPORTED);
+    }
+
+    let efer = unsafe { read_msr(X86_MSR_IA32_EFER) };
+    unsafe {
+        write_msr(X86_MSR_IA32_EFER, efer | X86_EFER_SVME);
+        write_msr(X86_MSR_AMD_VM_HSAVE_PA, hsave_pages[cpu_num as usize].physical_address().0 as u64);
+    }
+    Ok(())
+}
+
+/// Disables SVM on the current CPU.
+unsafe fn svm_off_task() {
+    unsafe {
+        write_msr(X86_MSR_AMD_VM_HSAVE_PA, 0);
+        let efer = read_msr(X86_MSR_IA32_EFER);
+        write_msr(X86_MSR_IA32_EFER, efer & !X86_EFER_SVME);
+    }
+}
+
+/// Enables AMD SVM on every online CPU if this is the first SVM guest.
+///
+/// # Safety
+///
+/// Same lifecycle invariants as `alloc_vmx_state`: called after `LK_INIT_LEVEL_KERNEL`
+/// and balanced with `free_svm_state`.
+pub unsafe fn alloc_svm_state() -> Result<(), Status> {
+    ksync::lock!(let mut guard = unsafe { SVM_GLOBAL_STATE.get_unchecked() }.lock_lock());
+    if NUM_SVM_GUESTS.load(Ordering::SeqCst) == 0 {
+        if !x86_feature_test(X86_FEATURE_SVM) {
+            return Err(Status::NOT_SUPPORTED);
+        }
+        let num_cpus = max_num_cpus() as usize;
+        if num_cpus > HOST_VMCB_PAS.len() {
+            return Err(Status::NOT_SUPPORTED);
+        }
+
+        let mut hsave = fbl::Array::<Page>::try_new(num_cpus).map_err(|_| Status::NO_MEMORY)?;
+        let mut host_vmcb = fbl::Array::<Page>::try_new(num_cpus).map_err(|_| Status::NO_MEMORY)?;
+        for p in hsave.iter_mut() {
+            p.alloc(0)?;
+        }
+        for (i, p) in host_vmcb.iter_mut().enumerate() {
+            p.alloc(0)?;
+            HOST_VMCB_PAS[i].store(p.physical_address().0 as u64, Ordering::Release);
+        }
+
+        let cpu_mask = percpu_exec(|cpu_num| unsafe { svm_on_task(&hsave, cpu_num) });
+        if cpu_mask != mp::get_online_mask() {
+            unsafe { sync_exec(MpIpiTarget::Mask, cpu_mask, || svm_off_task()) };
+            for slot in &HOST_VMCB_PAS[..num_cpus] {
+                slot.store(0, Ordering::Release);
+            }
+            return Err(Status::NOT_SUPPORTED);
+        }
+
+        *guard.as_mut().pages_mut() = PerCpuSvmPages { hsave, host_vmcb };
+    }
+    let prev = NUM_SVM_GUESTS.fetch_add(1, Ordering::SeqCst);
+    assert!(prev != usize::MAX);
+    Ok(())
+}
+
+/// Disables AMD SVM on every CPU if this is the last SVM guest.
+///
+/// # Safety
+///
+/// Must match a prior successful `alloc_svm_state` after all SVM VCPUs have been dropped.
+pub unsafe fn free_svm_state() {
+    ksync::lock!(let mut guard = unsafe { SVM_GLOBAL_STATE.get_unchecked() }.lock_lock());
+    let prev = NUM_SVM_GUESTS.fetch_sub(1, Ordering::SeqCst);
+    debug_assert!(prev != 0);
+    if prev == 1 {
+        unsafe { sync_exec(MpIpiTarget::All, 0, || svm_off_task()) };
+        for slot in &HOST_VMCB_PAS {
+            slot.store(0, Ordering::Release);
+        }
+        *guard.as_mut().pages_mut() =
+            PerCpuSvmPages { hsave: fbl::Array::new(), host_vmcb: fbl::Array::new() };
+    }
+}
+
+/// Returns the host `VMSAVE`/`VMLOAD` page physical address for `cpu_num`.
+#[inline]
+pub fn host_vmcb_paddr(cpu_num: cpu_num_t) -> PAddr {
+    let pa = HOST_VMCB_PAS[cpu_num as usize].load(Ordering::Acquire) as usize;
+    debug_assert!(pa != 0);
+    PAddr(pa)
+}
+
+/// Returns the current global SVM NPT TLB invalidation generation.
+#[inline]
+pub fn svm_tlb_gen() -> u64 {
+    SVM_TLB_GEN.load(Ordering::Acquire)
+}
+
+/// Broadcasts an NPT TLB flush to all CPUs by bumping the SVM TLB generation and
+/// issuing a synchronous IPI (so any currently running guest exits and reloads
+/// `tlb_control = FLUSH_ALL` before resuming).
+pub fn broadcast_svm_tlb_flush() {
+    SVM_TLB_GEN.fetch_add(1, Ordering::SeqCst);
+    if NUM_SVM_GUESTS.load(Ordering::SeqCst) != 0 {
+        // SAFETY: `MpIpiTarget::All` forces any CPU currently in a guest to take
+        // `VMEXIT_INTR`, re-check `svm_tlb_gen()`, and flush its NPT TLB on re-entry.
+        unsafe { sync_exec(MpIpiTarget::All, 0, || {}) };
+    }
+}
