+// https://opensource.org/licenses/MIT
+
+#include <asm.h>
+
+#include <arch/x86/hypervisor/vmx_state.h>
+#include <zircon/errors.h>
+
+.text
+
+/* zx_status_t svm_enter_asm(VmxState* state, zx_paddr_t guest_vmcb_pa, zx_paddr_t host_vmcb_pa)
+ *   %rdi = state (GuestState GPRs)
+ *   %rsi = guest_vmcb_pa (physical address of guest VMCB)
+ *   %rdx = host_vmcb_pa  (physical address of per-CPU host VMSAVE/VMLOAD page)
+ */
+FUNCTION(svm_enter_asm)
+    // Save callee-saved host registers and RFLAGS on the host stack.
+    push %rbx
+    push %rbp
+    push %r12
+    push %r13
+    push %r14
+    push %r15
+    pushf
+
+    // Save arguments on the host stack so they survive VMRUN (hardware saves/restores
+    // host %rsp automatically via VM_HSAVE_PA).
+    //   16(%rsp) = state
+    //    8(%rsp) = guest_vmcb_pa
+    //    0(%rsp) = host_vmcb_pa
+    push %rdi
+    push %rsi
+    push %rdx
+
+    // Clear Global Interrupt Flag around VMSAVE / VMLOAD / VMRUN / VMSAVE / VMLOAD.
+    // Under V_INTR_MASKING=1 (AMD64 APM Vol 2 §15.21.1), physical INTR delivery inside
+    // VMRUN is gated by host RFLAGS.IF, so we set IF=1 while GIF=0 (safe: GIF=0 blocks
+    // host interrupts until VMRUN implicitly sets GIF=1) and clear IF=0 again before STGI.
+    clgi
+    sti
+
+    // Save host FS/GS/TR/LDTR/KERNEL_GS_BASE/STAR/LSTAR/CSTAR/SFMASK/SYSENTER.
+    mov 0(%rsp), %rax
+    vmsave %rax
+
+    // Load guest FS/GS/TR/LDTR/KERNEL_GS_BASE/STAR/LSTAR/CSTAR/SFMASK/SYSENTER.
+    mov 8(%rsp), %rax
+    vmload %rax
+
+    // Load guest GPRs from VmxState.guest_state (RAX comes from VMCB.save.rax).
+    mov 16(%rsp), %rax
+    mov GS_RCX(%rax), %rcx
+    mov GS_RDX(%rax), %rdx
+    mov GS_RBX(%rax), %rbx
+    mov GS_RBP(%rax), %rbp
+    mov GS_RSI(%rax), %rsi
+    mov GS_RDI(%rax), %rdi
+    mov GS_R8(%rax), %r8
+    mov GS_R9(%rax), %r9
+    mov GS_R10(%rax), %r10
+    mov GS_R11(%rax), %r11
+    mov GS_R12(%rax), %r12
+    mov GS_R13(%rax), %r13
+    mov GS_R14(%rax), %r14
+    mov GS_R15(%rax), %r15
+
+    // %rax = guest_vmcb_pa; enter guest!
+    mov 8(%rsp), %rax
+    vmrun %rax
+
+    // On #VMEXIT, hardware has already restored host RIP, RSP, RFLAGS, CR0/3/4,
+    // EFER, CS/SS/DS/ES, GDTR, IDTR, and saved guest RAX into VMCB.save.rax.
+    // Save guest GPRs back to VmxState.guest_state (using %rax as base pointer).
+    mov 16(%rsp), %rax
+    mov %rcx, GS_RCX(%rax)
+    mov %rdx, GS_RDX(%rax)
+    mov %rbx, GS_RBX(%rax)
+    mov %rbp, GS_RBP(%rax)
+    mov %rsi, GS_RSI(%rax)
+    mov %rdi, GS_RDI(%rax)
+    mov %r8, GS_R8(%rax)
+    mov %r9, GS_R9(%rax)
+    mov %r10, GS_R10(%rax)
+    mov %r11, GS_R11(%rax)
+    mov %r12, GS_R12(%rax)
+    mov %r13, GS_R13(%rax)
+    mov %r14, GS_R14(%rax)
+    mov %r15, GS_R15(%rax)
+
+    // Save guest extra state and restore host FS/GS/TR/LDTR/SYSCALL MSRs.
+    mov 8(%rsp), %rax
+    vmsave %rax
+    mov 0(%rsp), %rax
+    vmload %rax
+
+    // Clear host RFLAGS.IF before re-enabling GIF so caller's interrupts-disabled
+    // invariant holds until svm_vmexit_handler explicitly services pending INTRs.
+    cli
+    stgi
+
+    // Zero guest-controlled GPRs (Spectre hygiene, matching vmx.S).
+    xor %ebx, %ebx
+    xor %ecx, %ecx
+    xor %edx, %edx
+    xor %esi, %esi
+    xor %edi, %edi
+    xor %r8, %r8
+    xor %r9, %r9
+    xor %r10, %r10
+    xor %r11, %r11
+    xor %r12, %r12
+    xor %r13, %r13
+    xor %r14, %r14
+    xor %r15, %r15
+
+    // Return ZX_OK.
+    xor %eax, %eax
+
+    // Pop saved arguments and callee-saved host registers.
+    add $24, %rsp
+    popf
+    pop %r15
+    pop %r14
+    pop %r13
+    pop %r12
+    pop %rbp
+    pop %rbx
+    ret
+END_FUNCTION(svm_enter_asm)
