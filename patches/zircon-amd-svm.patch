diff --git a/zircon/kernel/arch/x86/hypervisor/vmcb.rs b/zircon/kernel/arch/x86/hypervisor/vmcb.rs
new file mode 100644
index 00000000000..2c45d7ed42e
--- /dev/null
+++ b/zircon/kernel/arch/x86/hypervisor/vmcb.rs
@@ -0,0 +1,229 @@
+// Copyright 2026 The Hirsel-OS Authors
+//
+// Use of this source code is governed by a MIT-style
+// license that can be found in the LICENSE file or at
+// https://opensource.org/licenses/MIT
+
+//! AMD SVM Virtual Machine Control Block (VMCB) layout and constants.
+//!
+//! Reference: AMD64 Architecture Programmer's Manual, Volume 2, Appendix B
+//! (Layout of VMCB).
+
+use core::mem::{align_of, offset_of, size_of};
+use zr::static_assert;
+
+/// Segment register entry in the VMCB State Save Area (16 bytes).
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub struct VmcbSeg {
+    pub selector: u16,
+    pub attrib: u16,
+    pub limit: u32,
+    pub base: u64,
+}
+
+static_assert!(size_of::<VmcbSeg>() == 16);
+
+// VMCB intercept_misc1 (offset 0x00C) bits.
+pub const INTERCEPT_INTR: u32 = 1 << 0;
+pub const INTERCEPT_NMI: u32 = 1 << 1;
+pub const INTERCEPT_INIT: u32 = 1 << 3;
+pub const INTERCEPT_VINTR: u32 = 1 << 4;
+pub const INTERCEPT_CPUID: u32 = 1 << 18;
+pub const INTERCEPT_INVD: u32 = 1 << 22;
+pub const INTERCEPT_HLT: u32 = 1 << 24;
+pub const INTERCEPT_IOIO_PROT: u32 = 1 << 27;
+pub const INTERCEPT_MSR_PROT: u32 = 1 << 28;
+pub const INTERCEPT_SHUTDOWN: u32 = 1 << 31;
+
+// VMCB intercept_misc2 (offset 0x010) bits.
+pub const INTERCEPT_VMRUN: u32 = 1 << 0;
+pub const INTERCEPT_VMMCALL: u32 = 1 << 1;
+pub const INTERCEPT_VMLOAD: u32 = 1 << 2;
+pub const INTERCEPT_VMSAVE: u32 = 1 << 3;
+pub const INTERCEPT_STGI: u32 = 1 << 4;
+pub const INTERCEPT_CLGI: u32 = 1 << 5;
+pub const INTERCEPT_SKINIT: u32 = 1 << 6;
+pub const INTERCEPT_XSETBV: u32 = 1 << 13;
+
+// VMCB tlb_control (offset 0x05C) values.
+pub const TLB_CONTROL_DO_NOTHING: u8 = 0;
+pub const TLB_CONTROL_FLUSH_ALL: u8 = 1;
+pub const TLB_CONTROL_FLUSH_ASID: u8 = 3;
+
+// VMCB np_enable (offset 0x090) bits.
+pub const NP_ENABLE_NESTED_PAGING: u64 = 1 << 0;
+
+// VMCB v_intr_ctrl (offset 0x060) bits.
+pub const V_INTR_IRQ: u64 = 1 << 8;
+pub const V_INTR_IGN_TPR: u64 = 1 << 20;
+pub const V_INTR_MASKING: u64 = 1 << 24;
+
+// VMCB event_inj (offset 0x0A8) fields.
+pub const EVENT_INJ_TYPE_INTR: u64 = 0 << 8;
+pub const EVENT_INJ_TYPE_NMI: u64 = 2 << 8;
+pub const EVENT_INJ_TYPE_EXCEPTION: u64 = 3 << 8;
+pub const EVENT_INJ_EV: u64 = 1 << 11;
+pub const EVENT_INJ_VALID: u64 = 1 << 31;
+
+// AMD SVM VMEXIT codes (APM Vol 2, Appendix C).
+pub const VMEXIT_INTR: u64 = 0x060;
+pub const VMEXIT_NMI: u64 = 0x061;
+pub const VMEXIT_SMI: u64 = 0x062;
+pub const VMEXIT_INIT: u64 = 0x063;
+pub const VMEXIT_VINTR: u64 = 0x064;
+pub const VMEXIT_CPUID: u64 = 0x072;
+pub const VMEXIT_HLT: u64 = 0x078;
+pub const VMEXIT_INVD: u64 = 0x076;
+pub const VMEXIT_IOIO: u64 = 0x07b;
+pub const VMEXIT_MSR: u64 = 0x07c;
+pub const VMEXIT_SHUTDOWN: u64 = 0x07f;
+pub const VMEXIT_VMRUN: u64 = 0x080;
+pub const VMEXIT_VMMCALL: u64 = 0x081;
+pub const VMEXIT_VMLOAD: u64 = 0x082;
+pub const VMEXIT_VMSAVE: u64 = 0x083;
+pub const VMEXIT_STGI: u64 = 0x084;
+pub const VMEXIT_CLGI: u64 = 0x085;
+pub const VMEXIT_SKINIT: u64 = 0x086;
+pub const VMEXIT_XSETBV: u64 = 0x08d;
+pub const VMEXIT_NPF: u64 = 0x400;
+pub const VMEXIT_INVALID: u64 = u64::MAX;
+
+// Packed 12-bit AMD segment attributes (APM Vol 2, §15.5.1):
+// bits 3:0 = Type, bit 4 = S, bits 6:5 = DPL, bit 7 = P,
+// bit 8 = AVL, bit 9 = L, bit 10 = D/B, bit 11 = G.
+pub const SVM_SEG_ATTR_CODE64: u16 = 0x029b; // P=1, S=1, Type=0xB (code/R/A), L=1
+pub const SVM_SEG_ATTR_CODE16: u16 = 0x009b; // P=1, S=1, Type=0xB (code/R/A)
+pub const SVM_SEG_ATTR_DATA: u16 = 0x0093; // P=1, S=1, Type=0x3 (data/W/A)
+pub const SVM_SEG_ATTR_TSS_BUSY: u16 = 0x008b; // P=1, S=0, Type=0xB (64-bit TSS busy)
+pub const SVM_SEG_ATTR_LDT: u16 = 0x0082; // P=1, S=0, Type=0x2 (LDT)
+
+/// VMCB Control Area (bytes `0x000..0x400`).
+#[repr(C)]
+pub struct VmcbControlArea {
+    pub intercept_cr: u32,           // 0x000
+    pub intercept_dr: u32,           // 0x004
+    pub intercept_exceptions: u32,   // 0x008
+    pub intercept_misc1: u32,        // 0x00C
+    pub intercept_misc2: u32,        // 0x010
+    pub intercept_misc3: u32,        // 0x014
+    pub _reserved1: [u8; 0x24],      // 0x018..0x03C
+    pub pause_filter_thresh: u16,    // 0x03C
+    pub pause_filter_count: u16,     // 0x03E
+    pub iopm_base_pa: u64,           // 0x040
+    pub msrpm_base_pa: u64,          // 0x048
+    pub tsc_offset: u64,             // 0x050
+    pub guest_asid: u32,             // 0x058
+    pub tlb_control: u8,             // 0x05C
+    pub _reserved2: [u8; 3],         // 0x05D..0x060
+    pub v_intr_ctrl: u64,            // 0x060
+    pub interrupt_shadow: u64,       // 0x068
+    pub exit_code: u64,              // 0x070
+    pub exit_info_1: u64,            // 0x078
+    pub exit_info_2: u64,            // 0x080
+    pub exit_int_info: u64,          // 0x088
+    pub np_enable: u64,              // 0x090
+    pub avic_apic_bar: u64,          // 0x098
+    pub ghcb_gpa: u64,               // 0x0A0
+    pub event_inj: u64,              // 0x0A8
+    pub n_cr3: u64,                  // 0x0B0
+    pub lbr_virt_enable: u64,        // 0x0B8
+    pub clean_bits: u32,             // 0x0C0
+    pub _reserved3: u32,             // 0x0C4
+    pub next_rip: u64,               // 0x0C8
+    pub guest_inst_len: u8,          // 0x0D0
+    pub guest_inst_bytes: [u8; 15],  // 0x0D1..0x0E0
+    pub _reserved4: [u8; 0x320],     // 0x0E0..0x400
+}
+
+/// VMCB State Save Area (bytes `0x400..0x1000`).
+#[repr(C)]
+pub struct VmcbSaveArea {
+    pub es: VmcbSeg,                 // 0x000 (0x400)
+    pub cs: VmcbSeg,                 // 0x010 (0x410)
+    pub ss: VmcbSeg,                 // 0x020 (0x420)
+    pub ds: VmcbSeg,                 // 0x030 (0x430)
+    pub fs: VmcbSeg,                 // 0x040 (0x440)
+    pub gs: VmcbSeg,                 // 0x050 (0x450)
+    pub gdtr: VmcbSeg,               // 0x060 (0x460)
+    pub ldtr: VmcbSeg,               // 0x070 (0x470)
+    pub idtr: VmcbSeg,               // 0x080 (0x480)
+    pub tr: VmcbSeg,                 // 0x090 (0x490)
+    pub _reserved1: [u8; 0x2B],      // 0x0A0..0x0CB
+    pub cpl: u8,                     // 0x0CB (0x4CB)
+    pub _reserved2: u32,             // 0x0CC..0x0D0
+    pub efer: u64,                   // 0x0D0 (0x4D0)
+    pub _reserved3: [u8; 0x70],      // 0x0D8..0x148
+    pub cr4: u64,                    // 0x148 (0x548)
+    pub cr3: u64,                    // 0x150 (0x550)
+    pub cr0: u64,                    // 0x158 (0x558)
+    pub dr7: u64,                    // 0x160 (0x560)
+    pub dr6: u64,                    // 0x168 (0x568)
+    pub rflags: u64,                 // 0x170 (0x570)
+    pub rip: u64,                    // 0x178 (0x578)
+    pub _reserved4: [u8; 0x58],      // 0x180..0x1D8
+    pub rsp: u64,                    // 0x1D8 (0x5D8)
+    pub _reserved5: [u8; 0x18],      // 0x1E0..0x1F8
+    pub rax: u64,                    // 0x1F8 (0x5F8)
+    pub star: u64,                   // 0x200 (0x600)
+    pub lstar: u64,                  // 0x208 (0x608)
+    pub cstar: u64,                  // 0x210 (0x610)
+    pub sfmask: u64,                 // 0x218 (0x618)
+    pub kernel_gs_base: u64,         // 0x220 (0x620)
+    pub sysenter_cs: u64,            // 0x228 (0x628)
+    pub sysenter_esp: u64,           // 0x230 (0x630)
+    pub sysenter_eip: u64,           // 0x238 (0x638)
+    pub cr2: u64,                    // 0x240 (0x640)
+    pub _reserved6: [u8; 0x20],      // 0x248..0x268
+    pub g_pat: u64,                  // 0x268 (0x668)
+    pub _reserved7: [u8; 0x988],     // 0x270..0xBF8
+    /// Software-only field in unused VMCB tail tracking the last observed global SVM TLB gen.
+    pub sw_last_tlb_gen: u64,        // 0xBF8 (0xFF8)
+}
+
+/// Complete 4 KiB AMD SVM VMCB.
+#[repr(C, align(4096))]
+pub struct Vmcb {
+    pub control: VmcbControlArea,
+    pub save: VmcbSaveArea,
+}
+
+static_assert!(size_of::<VmcbControlArea>() == 0x400);
+static_assert!(size_of::<VmcbSaveArea>() == 0xC00);
+static_assert!(size_of::<Vmcb>() == 4096);
+static_assert!(align_of::<Vmcb>() == 4096);
+
+// Control area offset checks (AMD64 APM Vol 2, Table B-1).
+static_assert!(offset_of!(VmcbControlArea, intercept_misc1) == 0x00C);
+static_assert!(offset_of!(VmcbControlArea, intercept_misc2) == 0x010);
+static_assert!(offset_of!(VmcbControlArea, iopm_base_pa) == 0x040);
+static_assert!(offset_of!(VmcbControlArea, msrpm_base_pa) == 0x048);
+static_assert!(offset_of!(VmcbControlArea, guest_asid) == 0x058);
+static_assert!(offset_of!(VmcbControlArea, tlb_control) == 0x05C);
+static_assert!(offset_of!(VmcbControlArea, v_intr_ctrl) == 0x060);
+static_assert!(offset_of!(VmcbControlArea, interrupt_shadow) == 0x068);
+static_assert!(offset_of!(VmcbControlArea, exit_code) == 0x070);
+static_assert!(offset_of!(VmcbControlArea, exit_info_1) == 0x078);
+static_assert!(offset_of!(VmcbControlArea, exit_info_2) == 0x080);
+static_assert!(offset_of!(VmcbControlArea, np_enable) == 0x090);
+static_assert!(offset_of!(VmcbControlArea, event_inj) == 0x0A8);
+static_assert!(offset_of!(VmcbControlArea, n_cr3) == 0x0B0);
+static_assert!(offset_of!(VmcbControlArea, clean_bits) == 0x0C0);
+static_assert!(offset_of!(VmcbControlArea, next_rip) == 0x0C8);
+static_assert!(offset_of!(VmcbControlArea, guest_inst_len) == 0x0D0);
+
+// State save area offset checks (AMD64 APM Vol 2, Table B-2).
+static_assert!(offset_of!(Vmcb, save) == 0x400);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, cpl) == 0x4CB);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, efer) == 0x4D0);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, cr4) == 0x548);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, cr3) == 0x550);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, cr0) == 0x558);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, dr7) == 0x560);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, rflags) == 0x570);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, rip) == 0x578);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, rsp) == 0x5D8);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, rax) == 0x5F8);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, star) == 0x600);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, cr2) == 0x640);
+static_assert!(offset_of!(Vmcb, save) + offset_of!(VmcbSaveArea, g_pat) == 0x668);
