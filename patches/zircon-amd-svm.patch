+/// Injects a pending virtual interrupt or exception into `vmcb`, arming `INTERCEPT_VINTR`
+/// if guest interrupts are currently masked.
+pub fn svm_local_apic_maybe_interrupt(
+    vmcb: &mut Vmcb,
+    local_apic_state: &LocalApicState,
+) -> Result<(), Status> {
+    const NMI: u32 = X86_INT_NMI.0 as u32;
+    const VIRT: u32 = X86_INT_VIRT.0 as u32;
+    const PLATFORM_BASE: u32 = X86_INT_PLATFORM_BASE.0 as u32;
+
+    let vector = if local_apic_state.interrupt_tracker.try_pop(NMI) {
+        NMI
+    } else {
+        let Some(popped) = local_apic_state.interrupt_tracker.pop() else {
+            return Ok(());
+        };
+        debug_assert!(popped != X86InterruptVector::COUNT as u32);
+        popped
+    };
+
+    let interrupt_shadow = (vmcb.control.interrupt_shadow & 1) != 0;
+    let can_inject_ext = (vmcb.save.rflags & X86_FLAGS_IF) != 0 && !interrupt_shadow;
+    let can_inject_nmi = !interrupt_shadow;
+
+    if vector > VIRT && vector < PLATFORM_BASE {
+        return Err(Status::NOT_SUPPORTED);
+    } else if (vector >= PLATFORM_BASE && !can_inject_ext) || (vector == NMI && !can_inject_nmi) {
+        let result = local_apic_state.interrupt_tracker.track(vector);
+        if result.is_ok() {
+            // Request an exit as soon as guest opens an interrupt window.
+            vmcb.control.intercept_misc1 |= INTERCEPT_VINTR;
+            vmcb.control.v_intr_ctrl |= V_INTR_IRQ | V_INTR_IGN_TPR;
+        }
+        return result;
+    }
+
+    svm_issue_event(vmcb, vector);
+    local_apic_state.interrupt_tracker.clear(0, NMI);
+    local_apic_state.interrupt_tracker.clear(NMI + 1, VIRT + 1);
+    Ok(())
+}
+
+// --- Local x2APIC timer helpers (mirroring vmexit.rs) ---
+
+fn svm_lvt_deadline(local_apic_state: &LocalApicState, lvt_timer: u32) -> InstantMono {
+    if (lvt_timer & LVT_TIMER_MODE_MASK) != LVT_TIMER_MODE_ONESHOT
+        && (lvt_timer & LVT_TIMER_MODE_MASK) != LVT_TIMER_MODE_PERIODIC
+    {
+        return InstantMono(0);
+    }
+    let lvt_divide_config = u64::from(local_apic_state.lvt_divide_config.load(Ordering::Relaxed));
+    let shift =
+        (bits_shift(lvt_divide_config, 1, 0) | (bit_shift(lvt_divide_config, 3) << 2)) as u32;
+    let divisor_shift = (shift + 1) & 7;
+    let duration_tsc_ticks =
+        (local_apic_state.lvt_initial_count.load(Ordering::Relaxed) << divisor_shift) as i64;
+    let duration = convert_raw_tsc_duration_to_nanoseconds(duration_tsc_ticks);
+    current_mono_time() + duration
+}
+
+unsafe extern "C" fn svm_deadline_callback(_timer: *mut Timer, _now: i64, arg: *mut c_void) {
+    let local_apic_state = unsafe { &*arg.cast::<LocalApicState>() };
+    let lvt_timer = local_apic_state.lvt_timer.load(Ordering::Relaxed);
+    if lvt_timer & LVT_MASKED != 0 {
+        return;
+    }
+    if (lvt_timer & LVT_TIMER_MODE_MASK) == LVT_TIMER_MODE_PERIODIC {
+        unsafe { svm_set_timer(local_apic_state, svm_lvt_deadline(local_apic_state, lvt_timer)) };
+    }
+    let vector = (lvt_timer & LVT_TIMER_VECTOR_MASK) as u8;
+    let _ = local_apic_state.interrupt_tracker.interrupt(u32::from(vector));
+}
+
+unsafe fn svm_set_timer(local_apic_state: &LocalApicState, deadline: InstantMono) {
+    if deadline.0 > 0 {
+        unsafe {
+            Pin::new_unchecked(&local_apic_state.timer).set_oneshot(
+                deadline.0,
+                svm_deadline_callback,
+                core::ptr::from_ref(local_apic_state).cast_mut().cast(),
+            );
+        }
+    }
+}
+
+unsafe fn svm_update_timer(local_apic_state: &LocalApicState, deadline: InstantMono) {
+    local_apic_state.timer.cancel();
+    unsafe { svm_set_timer(local_apic_state, deadline) };
+}
+
+fn default_operand_size(vmcb: &Vmcb) -> u8 {
+    let is_64 = (vmcb.save.efer & X86_EFER_LMA) != 0 && (vmcb.save.cs.attrib & (1 << 9)) != 0;
+    let is_32 = (vmcb.save.cs.attrib & (1 << 10)) != 0;
+    if is_64 || is_32 { 4 } else { 2 }
+}
+
+fn decode_x86_mmio_inst_len(bytes: &[u8], is_64: bool) -> u8 {
+    let mut i = 0usize;
+    let mut op_override = false;
+    let mut addr_override = false;
+
+    while i < bytes.len() {
+        match bytes[i] {
+            0x66 => op_override = true,
+            0x67 => addr_override = true,
+            0x26 | 0x2E | 0x36 | 0x3E | 0x64 | 0x65 | 0xF0 | 0xF2 | 0xF3 => {}
+            _ => break,
+        }
+        i += 1;
+    }
+
+    let mut rex_w = false;
+    if is_64 && i < bytes.len() && (bytes[i] & 0xF0) == 0x40 {
+        rex_w = (bytes[i] & 0x08) != 0;
+        i += 1;
+    }
+
+    if i >= bytes.len() {
+        return 0;
+    }
+    let op = bytes[i];
+    i += 1;
+
+    let mut two_byte = false;
+    let mut op2 = 0u8;
+    if op == 0x0F {
+        if i >= bytes.len() {
+            return 0;
+        }
+        two_byte = true;
+        op2 = bytes[i];
+        i += 1;
+    } else if (0xA0..=0xA3).contains(&op) {
+        let moffs_len = if addr_override || !is_64 { 4 } else { 8 };
+        let total = i + moffs_len;
+        return if total <= 15 && total <= bytes.len() { total as u8 } else { 0 };
+    }
+
+    if i >= bytes.len() {
+        return 0;
+    }
+    let modrm = bytes[i];
+    i += 1;
+
+    let mod_bits = modrm >> 6;
+    let reg = (modrm >> 3) & 7;
+    let rm = modrm & 7;
+
+    if mod_bits != 3 {
+        if rm == 4 {
+            if i >= bytes.len() {
+                return 0;
+            }
+            let sib = bytes[i];
+            i += 1;
+            let base = sib & 7;
+            if mod_bits == 0 && base == 5 {
+                i += 4;
+            }
+        } else if mod_bits == 0 && rm == 5 {
+            i += 4;
+        }
+        if mod_bits == 1 {
+            i += 1;
+        } else if mod_bits == 2 {
+            i += 4;
+        }
+    }
+
+    let imm_len = if two_byte {
+        if op2 == 0xBA { 1 } else { 0 }
+    } else {
+        match op {
+            0xC6 | 0x80 | 0x82 | 0x83 | 0xC0 | 0xC1 | 0x6B => 1,
+            0xC7 | 0x81 | 0x69 => {
+                if op_override && !rex_w {
+                    2
+                } else {
+                    4
+                }
+            }
+            0xF6 if reg <= 1 => 1,
+            0xF7 if reg <= 1 => {
+                if op_override && !rex_w {
+                    2
+                } else {
+                    4
+                }
+            }
+            _ => 0,
+        }
+    };
+
+    i += imm_len;
+    if i <= 15 && i <= bytes.len() { i as u8 } else { 0 }
+}
+
+fn read_guest_u64(gpa: &GuestPhysicalAspace, paddr: zx_gpaddr_t) -> Option<u64> {
+    let ptr = gpa.create_guest_ptr(paddr, size_of::<u64>()).ok()?;
+    let raw = ptr.as_ptr::<u64>();
+    if raw.is_null() {
+        return None;
+    }
+    Some(unsafe { core::ptr::read_unaligned(raw) })
+}
+
+fn guest_vaddr_to_gpa(
+    gpa: &GuestPhysicalAspace,
+    cr0: u64,
+    cr3: u64,
+    efer: u64,
+    vaddr: u64,
+) -> Option<zx_gpaddr_t> {
+    if (cr0 & X86_CR0_PG) == 0 {
+        return Some(vaddr as zx_gpaddr_t);
+    }
+    if (efer & X86_EFER_LMA) == 0 {
+        return None;
+    }
+    const PTE_PRESENT: u64 = 1 << 0;
+    const PTE_PS: u64 = 1 << 7;
+    const ADDR_MASK: u64 = 0x000f_ffff_ffff_f000;
+
+    let pml4_idx = ((vaddr >> 39) & 0x1ff) * 8;
+    let pml4e = read_guest_u64(gpa, ((cr3 & ADDR_MASK) + pml4_idx) as zx_gpaddr_t)?;
+    if (pml4e & PTE_PRESENT) == 0 {
+        return None;
+    }
+    let pdpt_idx = ((vaddr >> 30) & 0x1ff) * 8;
+    let pdpte = read_guest_u64(gpa, ((pml4e & ADDR_MASK) + pdpt_idx) as zx_gpaddr_t)?;
+    if (pdpte & PTE_PRESENT) == 0 {
+        return None;
+    }
+    if (pdpte & PTE_PS) != 0 {
+        let base = pdpte & 0x000f_ffff_c000_0000;
+        return Some((base | (vaddr & 0x3fff_ffff)) as zx_gpaddr_t);
+    }
+    let pd_idx = ((vaddr >> 21) & 0x1ff) * 8;
+    let pde = read_guest_u64(gpa, ((pdpte & ADDR_MASK) + pd_idx) as zx_gpaddr_t)?;
+    if (pde & PTE_PRESENT) == 0 {
+        return None;
+    }
+    if (pde & PTE_PS) != 0 {
+        let base = pde & 0x000f_ffff_ffe0_0000;
+        return Some((base | (vaddr & 0x1f_ffff)) as zx_gpaddr_t);
+    }
+    let pt_idx = ((vaddr >> 12) & 0x1ff) * 8;
+    let pte = read_guest_u64(gpa, ((pde & ADDR_MASK) + pt_idx) as zx_gpaddr_t)?;
+    if (pte & PTE_PRESENT) == 0 {
+        return None;
+    }
+    Some(((pte & ADDR_MASK) | (vaddr & 0xfff)) as zx_gpaddr_t)
+}
+
+fn read_guest_inst_len(
+    guard: &mut AutoSvmGuard,
+    vmcb: &Vmcb,
+    gpa: &GuestPhysicalAspace,
+) -> u8 {
+    let is_64 = (vmcb.save.efer & X86_EFER_LMA) != 0 && (vmcb.save.cs.attrib & (1 << 9)) != 0;
+    if vmcb.control.next_rip > vmcb.save.rip {
+        let delta = vmcb.control.next_rip - vmcb.save.rip;
+        if delta <= 15 {
+            return delta as u8;
+        }
+    }
+    let fetched = usize::from(vmcb.control.guest_inst_len).min(15);
+    if fetched > 0 {
+        let decoded = decode_x86_mmio_inst_len(&vmcb.control.guest_inst_bytes[..fetched], is_64);
+        if decoded > 0 {
+            return decoded;
+        }
+    }
+    guard.invalidate();
+    let mut buf = [0u8; 15];
+    let mut count = 0usize;
+    let rip = vmcb.save.rip;
+    while count < buf.len() {
+        let va = rip.wrapping_add(count as u64);
+        let Some(paddr) = guest_vaddr_to_gpa(gpa, vmcb.save.cr0, vmcb.save.cr3, vmcb.save.efer, va)
+        else {
+            break;
+        };
+        let page_rem = 4096usize - (paddr & 0xfff);
+        let chunk = (buf.len() - count).min(page_rem);
+        let Ok(ptr) = gpa.create_guest_ptr(paddr, chunk) else {
+            break;
+        };
+        let raw = ptr.as_ptr::<u8>();
+        if raw.is_null() {
+            break;
+        }
+        unsafe {
+            core::ptr::copy_nonoverlapping(raw, buf.as_mut_ptr().add(count), chunk);
+        }
+        count += chunk;
+    }
+    if count > 0 {
+        decode_x86_mmio_inst_len(&buf[..count], is_64)
+    } else {
+        0
+    }
+}
+
+fn handle_npf(
+    guard: &mut AutoSvmGuard,
+    vmcb: &mut Vmcb,
+    gpa: &GuestPhysicalAspace,
+    traps: &TrapMap,
+    packet: &mut zx_port_packet_t,
+) -> Result<(), Status> {
+    let guest_paddr = vmcb.control.exit_info_2 as zx_gpaddr_t;
+    let is_write = (vmcb.control.exit_info_1 & (1 << 1)) != 0;
+    let is_read = !is_write;
+
+    if let Ok(trap) = traps.find_trap(ZX_GUEST_TRAP_BELL, guest_paddr) {
+        let rip = vmcb.save.rip as zx_vaddr_t;
+        let inst_len = read_guest_inst_len(guard, vmcb, gpa);
+        if inst_len > 0 {
+            vmcb.save.rip = vmcb.save.rip.wrapping_add(u64::from(inst_len));
+        }
+
+        return match trap.kind() {
+            ZX_GUEST_TRAP_BELL => {
+                if is_read {
+                    return Err(Status::NOT_SUPPORTED);
+                }
+                *packet = zx_port_packet_t::default();
+                packet.key = trap.key();
+                packet.packet_type = zx_packet_type_t::ZX_PKT_TYPE_GUEST_BELL;
+                set_packet(packet, zx_packet_guest_bell_t { addr: guest_paddr });
+                if !trap.has_port() {
+                    return Err(Status::BAD_STATE);
+                }
+                guard.invalidate();
+                trap.queue(packet, None)
+            }
+            ZX_GUEST_TRAP_MEM => {
+                *packet = zx_port_packet_t::default();
+                packet.key = trap.key();
+                packet.packet_type = zx_packet_type_t::ZX_PKT_TYPE_GUEST_MEM;
+                set_packet(
+                    packet,
+                    zx_packet_guest_mem_t {
+                        addr: guest_paddr,
+                        cr3: vmcb.save.cr3 as zx_gpaddr_t,
+                        rip,
+                        instruction_size: inst_len,
+                        default_operand_size: default_operand_size(vmcb),
+                    },
+                );
+                Err(Status::NEXT)
+            }
+            _ => Err(Status::BAD_STATE),
+        };
+    }
+
+    guard.invalidate();
+    if guest_paddr >= gpa.size() {
+        return Err(Status::OUT_OF_RANGE);
+    }
+    let result = gpa.page_fault(guest_paddr);
+    if result.is_err() {
+        dprintf!(
+            CRITICAL,
+            "hypervisor(svm): Unhandled NPF gpa={:#x} info1={:#x} rip={:#x}\n",
+            guest_paddr,
+            vmcb.control.exit_info_1,
+            vmcb.save.rip
+        );
+    }
+    result
+}
+
+fn handle_ioio(
+    guard: &mut AutoSvmGuard,
+    vmcb: &mut Vmcb,
+    guest_state: &mut GuestState,
+    traps: &TrapMap,
+    packet: &mut zx_port_packet_t,
+) -> Result<(), Status> {
+    let info1 = vmcb.control.exit_info_1;
+    let is_in = (info1 & (1 << 0)) != 0;
+    let is_str = (info1 & (1 << 2)) != 0;
+    let is_rep = (info1 & (1 << 3)) != 0;
+    let port = ((info1 >> 16) & 0xffff) as u16;
+    if is_str || is_rep {
+        dprintf!(
+            INFO,
+            "hypervisor(svm): Unsupported string IO port={:#x} rip={:#x}\n",
+            port,
+            vmcb.save.rip
+        );
+        return Err(Status::NOT_SUPPORTED);
+    }
+    let access_size: u8 = if (info1 & (1 << 4)) != 0 {
+        1
+    } else if (info1 & (1 << 5)) != 0 {
+        2
+    } else if (info1 & (1 << 6)) != 0 {
+        4
+    } else {
+        return Err(Status::NOT_SUPPORTED);
+    };
+
+    let trap = match traps.find_trap(ZX_GUEST_TRAP_IO, usize::from(port)) {
+        Ok(t) => t,
+        Err(st) => {
+            dprintf!(
+                INFO,
+                "hypervisor(svm): Unhandled IO {} port={:#x} size={} rip={:#x}\n",
+                if is_in { "in" } else { "out" },
+                port,
+                access_size,
+                vmcb.save.rip
+            );
+            return Err(st);
+        }
+    };
+
+    // For IOIO exits, AMD hardware stores the sequential next RIP in EXITINFO2.
+    vmcb.save.rip = vmcb.control.exit_info_2;
+
+    *packet = zx_port_packet_t::default();
+    packet.key = trap.key();
+    packet.packet_type = zx_packet_type_t::ZX_PKT_TYPE_GUEST_IO;
+
+    let mut io = zx_packet_guest_io_t {
+        port,
+        access_size,
+        input: is_in,
+        data: [0; 4],
+    };
+    if is_in {
+        if access_size == 4 {
+            guest_state.rax = 0;
+        }
+    } else {
+        let bytes = guest_state.rax.to_ne_bytes();
+        io.data[..usize::from(access_size)].copy_from_slice(&bytes[..usize::from(access_size)]);
+    }
+    set_packet(packet, io);
+    if !is_in && trap.has_port() {
+        guard.invalidate();
+        return trap.queue(packet, None);
+    }
+    Err(Status::NEXT)
+}
+
+fn compute_xsave_size(guest_xcr0: u64) -> u32 {
+    let mut xsave_size: u32 = 512 + 64;
+    for i in 2..=9u32 {
+        if guest_xcr0 & (1 << i) == 0 {
+            continue;
+        }
+        if let Some(leaf) = get_cpuid_subleaf(X86CpuidLeafNum::XSave, i)
+            && leaf != (CpuidLeaf { a: 0, b: 0, c: 0, d: 0 })
+        {
+            xsave_size = leaf.b.wrapping_add(leaf.a);
+        }
+    }
+    xsave_size
+}
+
+fn handle_cpuid(vmcb: &mut Vmcb, guest_state: &mut GuestState) -> Result<(), Status> {
+    let leaf = guest_state.eax();
+    let subleaf = guest_state.ecx();
+    let apic_id = vmcb.control.guest_asid.saturating_sub(1);
+    advance_rip(vmcb, 2);
+
+    let res = if leaf == 0x4000_0000 {
+        CpuidLeaf {
+            a: 0x4000_0001,
+            b: u32::from_le_bytes(*b"KVMK"),
+            c: u32::from_le_bytes(*b"VMKV"),
+            d: u32::from_le_bytes(*b"M\0\0\0"),
+        }
+    } else if leaf == 0x4000_0001 {
+        CpuidLeaf {
+            a: KVM_FEATURE_CLOCK_SOURCE_OLD | KVM_FEATURE_CLOCK_SOURCE | KVM_FEATURE_NO_IO_DELAY,
+            b: 0,
+            c: 0,
+            d: 0,
+        }
+    } else if leaf == 0x8000_001e {
+        CpuidLeaf { a: 0, b: 0, c: 0, d: 0 }
+    } else if leaf <= MAX_SUPPORTED_CPUID || (0x8000_0000..=MAX_SUPPORTED_CPUID_EXT).contains(&leaf)
+    {
+        // SAFETY: `leaf` is a valid standard or extended CPUID leaf.
+        let raw = core::arch::x86_64::__cpuid_count(leaf, subleaf);
+        CpuidLeaf { a: raw.eax, b: raw.ebx, c: raw.ecx, d: raw.edx }
+    } else {
+        CpuidLeaf { a: 0, b: 0, c: 0, d: 0 }
+    };
+
+    let mut eax = res.a;
+    let mut ebx = res.b;
+    let mut ecx = res.c;
+    let mut edx = res.d;
+
+    if leaf == X86CpuidLeafNum::Base as u32 {
+        eax = eax.min(MAX_SUPPORTED_CPUID);
+    } else if leaf == X86CpuidLeafNum::ModelFeatures as u32 {
+        // Override initial local APIC ID (bits 31:24); preserve logical processor count for SMP.
+        ebx = (ebx & 0x00ff_ffff) | ((apic_id & 0xff) << 24);
+        ecx |= feature_mask(X86_FEATURE_HYPERVISOR)
+            | feature_mask(X86_FEATURE_X2APIC)
+            | feature_mask(X86_FEATURE_TSC_DEADLINE);
+        ecx &= !(feature_mask(X86_FEATURE_VMX)
+            | feature_mask(X86_FEATURE_PDCM)
+            | feature_mask(X86_FEATURE_MON)
+            | feature_mask(X86_FEATURE_TM2));
+        edx |= feature_mask(X86_FEATURE_SEP);
+        edx &= !(feature_mask(X86_FEATURE_TM) | feature_mask(X86_FEATURE_ACPI));
+    } else if leaf == X86CpuidLeafNum::Mon as u32 {
+        eax = 0;
+        ebx = 0;
+        ecx = 0;
+        edx = 0;
+    } else if leaf == X86CpuidLeafNum::ThermalAndPower as u32 {
+        ecx &= !(feature_mask(X86_FEATURE_PERF_BIAS) | feature_mask(X86_FEATURE_HW_FEEDBACK));
+        eax &= !(feature_mask(X86_FEATURE_DTS)
+            | feature_mask(X86_FEATURE_PTM)
+            | feature_mask(X86_FEATURE_PLN)
+            | feature_mask(X86_FEATURE_HWP)
+            | feature_mask(X86_FEATURE_HWP_NOT)
+            | feature_mask(X86_FEATURE_HWP_ACT)
+            | feature_mask(X86_FEATURE_HWP_PREF)
+            | feature_mask(X86_FEATURE_TURBO)
+            | feature_mask(X86_FEATURE_TURBO_MAX));
+    } else if leaf == X86CpuidLeafNum::ExtendedFeatureFlags as u32 {
+        ebx &= !(feature_mask(X86_FEATURE_PT)
+            | feature_mask(X86_FEATURE_TSC_ADJUST)
+            | feature_mask(X86_FEATURE_AVX512F)
+            | feature_mask(X86_FEATURE_AVX512DQ)
+            | feature_mask(X86_FEATURE_AVX512IFMA)
+            | feature_mask(X86_FEATURE_AVX512PF)
+            | feature_mask(X86_FEATURE_AVX512ER)
+            | feature_mask(X86_FEATURE_AVX512CD)
+            | feature_mask(X86_FEATURE_AVX512BW)
+            | feature_mask(X86_FEATURE_AVX512VL));
+        ecx &= !(feature_mask(X86_FEATURE_LA57)
+            | feature_mask(X86_FEATURE_AVX512VBMI)
+            | feature_mask(X86_FEATURE_AVX512VBMI2)
+            | feature_mask(X86_FEATURE_AVX512VNNI)
+            | feature_mask(X86_FEATURE_AVX512BITALG)
+            | feature_mask(X86_FEATURE_AVX512VPDQ));
+        edx &= !(feature_mask(X86_FEATURE_IBRS_IBPB)
+            | feature_mask(X86_FEATURE_STIBP)
+            | feature_mask(X86_FEATURE_SSBD)
+            | feature_mask(X86_FEATURE_ARCH_CAPABILITIES)
+            | feature_mask(X86_FEATURE_L1D_FLUSH)
+            | feature_mask(X86_FEATURE_AVX512QVNNIW)
+            | feature_mask(X86_FEATURE_AVX512QFMA));
+    } else if leaf == X86CpuidLeafNum::PerformanceMonitoring as u32 {
+        eax = 0;
+        ebx = 0b1111111;
+        ecx = 0;
+        edx = 0;
+    } else if leaf == X86CpuidLeafNum::Topology as u32 {
+        if subleaf == 0 {
+            eax = 0;
+            ebx = u32::from(X86_FEATURE_TOPOLOGY_SINGLE_PROCESSOR.bit);
+            ecx = feature_mask(X86_FEATURE_TOPOLOGY_LOGICAL_PROCESSOR);
+            edx = apic_id;
+        } else {
+            eax = 0;
+            ebx = 0;
+            ecx = 0;
+            edx = 0;
+        }
+    } else if leaf == X86CpuidLeafNum::XSave as u32 {
+        if subleaf == 0 {
+            ebx = compute_xsave_size(guest_state.xcr0);
+        } else if subleaf == 1 {
+            // Clear XSAVEC (bit 1) and XSAVES/IA32_XSS (bit 3).
+            eax &= !((1 << 1) | (1 << 3));
+            ebx = 0;
+            ecx = 0;
+            edx = 0;
+        }
+    } else if leaf == X86CpuidLeafNum::ExtBase as u32 {
+        eax = eax.min(MAX_SUPPORTED_CPUID_EXT);
+    } else if leaf == X86CpuidLeafNum::ExtModelFeatures as u32 {
+        // Hide SVM, TopologyExt (22), PerfCtrCore (23), MwaitX (29).
+        ecx &= !(feature_mask(X86_FEATURE_SVM) | (1 << 22) | (1 << 23) | (1 << 29));
+    } else if leaf == 0x8000_0008 {
+        // Clear AMD IBPB/IBRS/STIBP/SSBD/PSFD speculation-control bits in EBX.
+        ebx &= !0x1fff_f000;
+    }
+
+    guest_state.rax = u64::from(eax);
+    guest_state.rbx = u64::from(ebx);
+    guest_state.rcx = u64::from(ecx);
+    guest_state.rdx = u64::from(edx);
+    Ok(())
+}
+
+fn handle_x2apic_rdmsr(
+    vmcb: &mut Vmcb,
+    guest_state: &mut GuestState,
+    local_apic_state: &LocalApicState,
+) {
+    let msr = guest_state.ecx();
+    let apic_id = vmcb.control.guest_asid.saturating_sub(1);
+    let val = match msr {
+        X2APIC_ID => u64::from(apic_id),
+        X2APIC_VERSION => 0x0006_0015, // modern APIC v0x15, 7 LVT entries
+        X2APIC_SVR => 0x1ff,           // APIC software-enabled + spurious vector 0xff
+        X2APIC_LDR => u64::from(((apic_id & !0xf) << 12) | (1u32 << (apic_id & 0xf))),
+        X2APIC_TPR
+        | X2APIC_ESR
+        | X2APIC_LVT_MONITOR
+        | X2APIC_CURRENT_COUNT
+        | X2APIC_ISR_START..=X2APIC_IRR_END => 0,
+        X2APIC_LVT_LINT0 | X2APIC_LVT_LINT1 | X2APIC_LVT_THERMAL | X2APIC_LVT_CMCI
+        | X2APIC_LVT_ERROR => u64::from(LVT_MASKED),
+        X2APIC_LVT_TIMER => u64::from(local_apic_state.lvt_timer.load(Ordering::Relaxed)),
+        X2APIC_INITIAL_COUNT => {
+            u64::from(local_apic_state.lvt_initial_count.load(Ordering::Relaxed))
+        }
+        X2APIC_DCR => u64::from(local_apic_state.lvt_divide_config.load(Ordering::Relaxed)),
+        _ => {
+            svm_issue_event(vmcb, X86_INT_GP_FAULT.0 as u32);
+            return;
+        }
+    };
+    advance_rip(vmcb, 2);
+    guest_state.set_edx_eax(val);
+}
+
+fn handle_x2apic_wrmsr(
+    vmcb: &mut Vmcb,
+    guest_state: &GuestState,
+    local_apic_state: &LocalApicState,
+    packet: &mut zx_port_packet_t,
+) -> Result<(), Status> {
+    let msr = guest_state.ecx();
+    if guest_state.edx() != 0 && msr != X2APIC_ICR {
+        svm_issue_event(vmcb, X86_INT_GP_FAULT.0 as u32);
+        return Ok(());
+    }
+    match msr {
+        X2APIC_EOI | X2APIC_ESR => {
+            if guest_state.eax() != 0 {
+                svm_issue_event(vmcb, X86_INT_GP_FAULT.0 as u32);
+                return Ok(());
+            }
+            advance_rip(vmcb, 2);
+            Ok(())
+        }
+        X2APIC_TPR
+        | X2APIC_SVR
+        | X2APIC_LVT_MONITOR
+        | X2APIC_LVT_ERROR
+        | X2APIC_LVT_LINT0
+        | X2APIC_LVT_LINT1
+        | X2APIC_LVT_THERMAL
+        | X2APIC_LVT_CMCI => {
+            advance_rip(vmcb, 2);
+            Ok(())
+        }
+        X2APIC_LVT_TIMER => {
+            let lvt_timer = guest_state.eax();
+            if (lvt_timer & LVT_TIMER_MODE_MASK) == LVT_TIMER_MODE_RESERVED {
+                return Err(Status::INVALID_ARGS);
+            }
+            advance_rip(vmcb, 2);
+            local_apic_state.lvt_timer.store(lvt_timer, Ordering::Relaxed);
+            // SAFETY: `local_apic_state` is pinned in `Vcpu` and canceled in teardown.
+            unsafe {
+                svm_update_timer(local_apic_state, svm_lvt_deadline(local_apic_state, lvt_timer));
+            }
+            Ok(())
+        }
+        X2APIC_INITIAL_COUNT => {
+            advance_rip(vmcb, 2);
+            local_apic_state.lvt_initial_count.store(guest_state.eax(), Ordering::Relaxed);
+            let lvt_timer = local_apic_state.lvt_timer.load(Ordering::Relaxed);
+            unsafe {
+                svm_update_timer(local_apic_state, svm_lvt_deadline(local_apic_state, lvt_timer));
+            }
+            Ok(())
+        }
+        X2APIC_DCR => {
+            advance_rip(vmcb, 2);
+            local_apic_state.lvt_divide_config.store(guest_state.eax(), Ordering::Relaxed);
+            let lvt_timer = local_apic_state.lvt_timer.load(Ordering::Relaxed);
+            unsafe {
+                svm_update_timer(local_apic_state, svm_lvt_deadline(local_apic_state, lvt_timer));
+            }
+            Ok(())
+        }
+        X2APIC_SELF_IPI => {
+            advance_rip(vmcb, 2);
+            let vector = guest_state.eax() & 0xff;
+            local_apic_state.interrupt_tracker.interrupt(vector)
+        }
+        X2APIC_ICR => {
+            // Full x2APIC ICR virtualization (FIXED, NMI, INIT, STARTUP/SIPI) matching VMX `handle_ipi`.
+            let lo = guest_state.eax();
+            let dest = guest_state.edx();
+            let delivery = (lo >> 8) & 0x7;
+            let dest_logical = ((lo >> 11) & 1) != 0;
+            let shorthand = (lo >> 18) & 0x3;
+            let vector = (lo & 0xff) as u8;
+            let self_id = vmcb.control.guest_asid.saturating_sub(1);
+            let self_mask = if (self_id as usize) < MAX_GUEST_VCPUS {
+                1u64 << self_id
+            } else {
+                0
+            };
+
+            if dest_logical {
+                return Err(Status::NOT_SUPPORTED);
+            }
+
+            let target_mask = match shorthand {
+                0 => {
+                    if dest == u32::MAX {
+                        u64::MAX
+                    } else if (dest as usize) < MAX_GUEST_VCPUS {
+                        1u64 << dest
+                    } else {
+                        0
+                    }
+                }
+                1 => self_mask,
+                2 => u64::MAX,
+                3 => !self_mask,
+                _ => 0,
+            };
+
+            match delivery {
+                // FIXED
+                0 => {
+                    advance_rip(vmcb, 2);
+                    if target_mask == 0 {
+                        return Ok(());
+                    }
+                    if target_mask == self_mask {
+                        return local_apic_state.interrupt_tracker.interrupt(u32::from(vector));
+                    }
+                    let mut vcpu_pkt = zx_packet_guest_vcpu_t::default();
+                    vcpu_pkt.r#type = zx_packet_guest_vcpu_type_t::ZX_PKT_GUEST_VCPU_INTERRUPT;
+                    let mut interrupt = zx_packet_guest_vcpu_interrupt_t::default();
+                    interrupt.mask = target_mask;
+                    interrupt.vector = vector;
+                    vcpu_pkt.union = zx_packet_guest_vcpu_union_t { interrupt };
+                    *packet = zx_port_packet_t::default();
+                    packet.packet_type = zx_packet_type_t::ZX_PKT_TYPE_GUEST_VCPU;
+                    set_packet(packet, vcpu_pkt);
+                    Err(Status::NEXT)
+                }
+                // NMI
+                4 => {
+                    advance_rip(vmcb, 2);
+                    let mut vcpu_pkt = zx_packet_guest_vcpu_t::default();
+                    vcpu_pkt.r#type = zx_packet_guest_vcpu_type_t::ZX_PKT_GUEST_VCPU_INTERRUPT;
+                    let mut interrupt = zx_packet_guest_vcpu_interrupt_t::default();
+                    interrupt.mask = target_mask & !self_mask;
+                    interrupt.vector = X86_INT_NMI.0;
+                    vcpu_pkt.union = zx_packet_guest_vcpu_union_t { interrupt };
+                    *packet = zx_port_packet_t::default();
+                    packet.packet_type = zx_packet_type_t::ZX_PKT_TYPE_GUEST_VCPU;
+                    set_packet(packet, vcpu_pkt);
+                    Err(Status::NEXT)
+                }
+                // INIT (ignored; AP startup happens on SIPI)
+                5 => {
+                    advance_rip(vmcb, 2);
+                    Ok(())
+                }
+                // STARTUP (SIPI)
+                6 => {
+                    advance_rip(vmcb, 2);
+                    let mut vcpu_pkt = zx_packet_guest_vcpu_t::default();
+                    vcpu_pkt.r#type = zx_packet_guest_vcpu_type_t::ZX_PKT_GUEST_VCPU_STARTUP;
+                    vcpu_pkt.union = zx_packet_guest_vcpu_union_t {
+                        startup: zx_packet_guest_vcpu_startup_t {
+                            target: u64::from(dest),
+                            entry: zx_gpaddr_t::from(vector) << 12,
+                            context: 0,
+                        },
+                    };
+                    *packet = zx_port_packet_t::default();
+                    packet.packet_type = zx_packet_type_t::ZX_PKT_TYPE_GUEST_VCPU;
+                    set_packet(packet, vcpu_pkt);
+                    Err(Status::NEXT)
+                }
+                _ => Err(Status::NOT_SUPPORTED),
+            }
+        }
+        _ => {
+            svm_issue_event(vmcb, X86_INT_GP_FAULT.0 as u32);
+            Ok(())
+        }
+    }
+}
+
+fn handle_msr(
+    guard: &mut AutoSvmGuard,
+    vmcb: &mut Vmcb,
+    guest_state: &mut GuestState,
+    local_apic_state: &LocalApicState,
+    pv_clock: &mut PvClockState,
+    gpa: &GuestPhysicalAspace,
+    packet: &mut zx_port_packet_t,
+) -> Result<(), Status> {
+    let is_write = vmcb.control.exit_info_1 != 0;
+    let msr = guest_state.ecx();
+
+    if !is_write {
+        match msr {
+            X86_MSR_IA32_APIC_BASE => {
+                let mut val = LOCAL_APIC_PHYS_BASE;
+                if vmcb.control.guest_asid == 1 {
+                    val |= IA32_APIC_BASE_BSP;
+                }
+                advance_rip(vmcb, 2);
+                guest_state.set_edx_eax(val);
+                Ok(())
+            }
+            X86_MSR_IA32_MISC_ENABLE => {
+                advance_rip(vmcb, 2);
+                guest_state.set_edx_eax(MISC_ENABLE_FAST_STRINGS);
+                Ok(())
+            }
+            X2APIC_MSR_BASE..=X2APIC_MSR_MAX => {
+                handle_x2apic_rdmsr(vmcb, guest_state, local_apic_state);
+                Ok(())
+            }
+            X86_MSR_DRAM_ENERGY_STATUS
+            | X86_MSR_DRAM_POWER_LIMIT
+            | X86_MSR_IA32_MTRRCAP
+            | X86_MSR_IA32_MTRR_DEF_TYPE
+            | X86_MSR_IA32_MTRR_FIX64K_00000
+            | X86_MSR_IA32_MTRR_FIX16K_80000..=X86_MSR_IA32_MTRR_FIX16K_A0000
+            | X86_MSR_IA32_MTRR_FIX4K_C0000..=X86_MSR_IA32_MTRR_FIX4K_F8000
+            | X86_MSR_IA32_MTRR_PHYSBASE0..=X86_MSR_IA32_MTRR_PHYSMASK9
+            | X86_MSR_IA32_PLATFORM_ID
+            | X86_MSR_IA32_BIOS_SIGN_ID
+            | X86_MSR_IA32_MCG_CAP
+            | X86_MSR_IA32_MCG_STATUS
+            | X86_MSR_IA32_TEMPERATURE_TARGET
+            | X86_MSR_PKG_ENERGY_STATUS
+            | X86_MSR_PLATFORM_ENERGY_COUNTER
+            | X86_MSR_PLATFORM_POWER_LIMIT
+            | X86_MSR_PP0_ENERGY_STATUS
+            | X86_MSR_PP0_POWER_LIMIT
+            | X86_MSR_PP1_ENERGY_STATUS
+            | X86_MSR_PP1_POWER_LIMIT
+            | X86_MSR_RAPL_POWER_UNIT
+            | X86_MSR_PPERF
+            | X86_MSR_SMI_COUNT
+            | X86_MSR_IA32_SPEC_CTRL
+            | X86_MSR_IA32_TSC_AUX
+            | X86_MSR_IA32_CSTAR
+            | 0x0000_003a // IA32_FEATURE_CONTROL
+            | 0x0000_010a // IA32_ARCH_CAPABILITIES
+            | 0xc001_0000..=0xc001_103f => {
+                advance_rip(vmcb, 2);
+                guest_state.set_edx_eax(0);
+                Ok(())
+            }
+            _ => {
+                // Fault: do NOT advance RIP so Linux's `__ex_table` (`rdmsr_safe`) matches!
+                svm_issue_event(vmcb, X86_INT_GP_FAULT.0 as u32);
+                Ok(())
+            }
+        }
+    } else {
+        match msr {
+            X86_MSR_IA32_APIC_BASE
+            | X86_MSR_IA32_MISC_ENABLE
+            | X86_MSR_IA32_MTRRCAP
+            | X86_MSR_IA32_MTRR_DEF_TYPE
+            | X86_MSR_IA32_MTRR_FIX64K_00000
+            | X86_MSR_IA32_MTRR_FIX16K_80000..=X86_MSR_IA32_MTRR_FIX16K_A0000
+            | X86_MSR_IA32_MTRR_FIX4K_C0000..=X86_MSR_IA32_MTRR_FIX4K_F8000
+            | X86_MSR_IA32_MTRR_PHYSBASE0..=X86_MSR_IA32_MTRR_PHYSMASK9
+            | X86_MSR_IA32_BIOS_SIGN_ID
+            | X86_MSR_DRAM_POWER_LIMIT
+            | X86_MSR_PP0_POWER_LIMIT
+            | X86_MSR_PP1_POWER_LIMIT
+            | X86_MSR_PLATFORM_POWER_LIMIT
+            | X86_MSR_IA32_SPEC_CTRL
+            | X86_MSR_IA32_PRED_CMD
+            | X86_MSR_IA32_CSTAR
+            | X86_MSR_IA32_TSC_AUX
+            | 0xc001_0000..=0xc001_103f => {
+                advance_rip(vmcb, 2);
+                Ok(())
+            }
+            X86_MSR_IA32_TSC_DEADLINE => {
+                advance_rip(vmcb, 2);
+                if (local_apic_state.lvt_timer.load(Ordering::Relaxed) & LVT_TIMER_MODE_MASK)
+                    == LVT_TIMER_MODE_TSC_DEADLINE
+                {
+                    let tsc_deadline = guest_state.edx_eax() as i64;
+                    let mono_deadline =
+                        InstantMono(convert_raw_tsc_timestamp_to_clock_monotonic(tsc_deadline));
+                    unsafe { svm_update_timer(local_apic_state, mono_deadline) };
+                }
+                Ok(())
+            }
+            X2APIC_MSR_BASE..=X2APIC_MSR_MAX => {
+                handle_x2apic_wrmsr(vmcb, guest_state, local_apic_state, packet)
+            }
+            KVM_SYSTEM_TIME_MSR_OLD | KVM_SYSTEM_TIME_MSR => {
+                let guest_paddr = guest_state.edx_eax() as zx_paddr_t;
+                advance_rip(vmcb, 2);
+                guard.invalidate();
+                if (guest_paddr & 1) != 0 {
+                    pv_clock_reset_clock(pv_clock, gpa, guest_paddr & !1)
+                } else {
+                    pv_clock_stop_clock(pv_clock);
+                    Ok(())
+                }
+            }
+            KVM_BOOT_TIME_OLD | KVM_BOOT_TIME => {
+                let guest_paddr = guest_state.edx_eax() as zx_paddr_t;
+                advance_rip(vmcb, 2);
+                guard.invalidate();
+                pv_clock_update_boot_time(gpa, guest_paddr)
+            }
+            _ => {
+                // Fault: do NOT advance RIP so Linux's `__ex_table` (`wrmsr_safe`) matches!
+                svm_issue_event(vmcb, X86_INT_GP_FAULT.0 as u32);
+                Ok(())
+            }
+        }
+    }
+}
+
+fn handle_xsetbv(vmcb: &mut Vmcb, guest_state: &mut GuestState) -> Result<(), Status> {
+    let xcr = guest_state.ecx();
+    let val = guest_state.edx_eax();
+    let allowed = X86_XSAVE_STATE_BIT_X87 | X86_XSAVE_STATE_BIT_SSE | X86_XSAVE_STATE_BIT_AVX;
+    if xcr != 0 || (val & X86_XSAVE_STATE_BIT_X87) == 0 || (val & !allowed) != 0 {
+        svm_issue_event(vmcb, X86_INT_GP_FAULT.0 as u32);
+        return Ok(());
+    }
+    guest_state.xcr0 = val;
+    advance_rip(vmcb, 3);
+    Ok(())
+}
+
+fn handle_vmmcall(
+    guard: &mut AutoSvmGuard,
+    vmcb: &mut Vmcb,
+    guest_state: &mut GuestState,
+    gpa: &GuestPhysicalAspace,
+) -> Result<(), Status> {
+    advance_rip(vmcb, 3);
+    if vmcb.save.cpl != 0 {
+        guest_state.rax = (-1i64) as u64; // -EPERM
+        return Ok(());
+    }
+    // KVM_HC_CLOCK_PAIRING = 9
+    if guest_state.rax == 9 {
+        if guest_state.rcx != 0 {
+            guest_state.rax = (-95i64) as u64; // -EOPNOTSUPP
+            return Ok(());
+        }
+        guard.invalidate();
+        if pv_clock_populate_offset(gpa, guest_state.rbx as zx_vaddr_t).is_ok() {
+            guest_state.rax = 0;
+        } else {
+            guest_state.rax = (-14i64) as u64; // -EFAULT
+        }
+    } else {
+        guest_state.rax = (-1000i64) as u64; // KVM_ENOSYS
+    }
+    Ok(())
+}
+
+/// Dispatches an AMD SVM VM exit.
+#[allow(clippy::too_many_arguments)]
+pub fn svm_vmexit_handler(
+    guard: &mut AutoSvmGuard,
+    vmcb: &mut Vmcb,
+    guest_state: &mut GuestState,
+    local_apic_state: &LocalApicState,
+    pv_clock_state: &mut PvClockState,
+    gpa: &GuestPhysicalAspace,
+    traps: &TrapMap,
+    packet: &mut zx_port_packet_t,
+) -> Result<(), Status> {
+    // Sync guest RAX/CR2 from VMCB save area into `guest_state`.
+    guest_state.rax = vmcb.save.rax;
+    guest_state.cr2 = vmcb.save.cr2;
+
+    let result = match vmcb.control.exit_code {
+        VMEXIT_INTR => {
+            PerCpu::get_current().gstats.arch.interrupts.fetch_add(1, Ordering::Relaxed);
+            guard.service_pending_external_interrupt();
+            Ok(())
+        }
+        VMEXIT_NMI => Ok(()),
+        VMEXIT_VINTR => {
+            vmcb.control.intercept_misc1 &= !INTERCEPT_VINTR;
+            vmcb.control.v_intr_ctrl &= !V_INTR_IRQ;
+            Ok(())
+        }
+        VMEXIT_NPF => {
+            PerCpu::get_current().gstats.arch.ept_violations.fetch_add(1, Ordering::Relaxed);
+            handle_npf(guard, vmcb, gpa, traps, packet)
+        }
+        VMEXIT_IOIO => {
+            PerCpu::get_current().gstats.arch.io_instructions.fetch_add(1, Ordering::Relaxed);
+            handle_ioio(guard, vmcb, guest_state, traps, packet)
+        }
+        VMEXIT_CPUID => {
+            PerCpu::get_current().gstats.arch.cpuid_instructions.fetch_add(1, Ordering::Relaxed);
+            handle_cpuid(vmcb, guest_state)
+        }
+        VMEXIT_HLT => {
+            PerCpu::get_current().gstats.arch.hlt_instructions.fetch_add(1, Ordering::Relaxed);
+            advance_rip(vmcb, 1);
+            guard.invalidate();
+            local_apic_state
+                .interrupt_tracker
+                .wait(InstantMono(ZX_TIME_INFINITE), None)
+        }
+        VMEXIT_INVD => {
+            advance_rip(vmcb, 2);
+            Ok(())
+        }
+        VMEXIT_MSR => {
+            PerCpu::get_current().gstats.arch.wrmsr_instructions.fetch_add(1, Ordering::Relaxed);
+            handle_msr(guard, vmcb, guest_state, local_apic_state, pv_clock_state, gpa, packet)
+        }
+        VMEXIT_XSETBV => handle_xsetbv(vmcb, guest_state),
+        VMEXIT_VMMCALL => handle_vmmcall(guard, vmcb, guest_state, gpa),
+        VMEXIT_SHUTDOWN => Err(Status::BAD_STATE),
+        VMEXIT_INVALID => {
+            dprintf!(
+                CRITICAL,
+                "hypervisor(svm): VMEXIT_INVALID rip={:#x} cr0={:#x} cr4={:#x} efer={:#x}\n",
+                vmcb.save.rip,
+                vmcb.save.cr0,
+                vmcb.save.cr4,
+                vmcb.save.efer
+            );
+            Err(Status::INTERNAL)
+        }
+        other => {
+            dprintf!(
+                CRITICAL,
+                "hypervisor(svm): Unhandled VMEXIT code={:#x} info1={:#x} info2={:#x} rip={:#x}\n",
+                other,
+                vmcb.control.exit_info_1,
+                vmcb.control.exit_info_2,
+                vmcb.save.rip
+            );
+            Err(Status::NOT_SUPPORTED)
+        }
+    };
+
+    vmcb.save.rax = guest_state.rax;
+    vmcb.save.cr2 = guest_state.cr2;
+    result
+}
