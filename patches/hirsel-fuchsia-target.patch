@@ -0,0 +1,137 @@
+//! Exec provider stub on Fuchsia/Zircon (Hirsel-OS spawns Tier 1 workloads via
+//! Zircon jobs from `hirsel-init` rather than POSIX fork/exec).
+use std::{
+    ffi::{CStr, CString},
+    io,
+    os::fd::OwnedFd,
+    sync::Arc,
+};
+
+pub struct SpawnInput {
+    pub image: Arc<OwnedFd>,
+    pub interpreter: Option<Arc<CStr>>,
+    pub cwd: OwnedFd,
+    pub argv: Vec<CString>,
+    pub envp: Vec<CString>,
+    pub piped: [bool; 3],
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Termination {
+    Exited(u8),
+    Signalled(u8),
+}
+
+#[derive(Clone, Copy)]
+pub enum Signal {
+    Int,
+    Term,
+    Kill,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[repr(i32)]
+pub(crate) enum SetupStep {
+    Stdio = 1,
+    Cwd,
+    Close,
+    Signals,
+    Exec,
+}
+
+#[derive(Debug)]
+pub struct SpawnError {
+    pub error: io::Error,
+    pub(crate) step: Option<SetupStep>,
+}
+
+impl From<io::Error> for SpawnError {
+    fn from(error: io::Error) -> Self {
+        Self { error, step: None }
+    }
+}
+
+impl std::fmt::Display for SpawnError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        if let Some(step) = self.step {
+            write!(f, "{step:?}: ")?;
+        }
+        self.error.fmt(f)
+    }
+}
+
+impl std::error::Error for SpawnError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.error)
+    }
+}
+
+pub struct Spawned {
+    pub process: Process,
+    pub stdin: Option<OwnedFd>,
+    pub stdout: Option<OwnedFd>,
+    pub stderr: Option<OwnedFd>,
+}
+
+pub struct Supervisor;
+
+impl Supervisor {
+    pub fn start(_probe: fn() -> io::Result<()>) -> io::Result<Self> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "POSIX Exec supervisor is not supported on Fuchsia",
+        ))
+    }
+
+    pub fn spawn(&self, _input: SpawnInput) -> Result<Spawned, SpawnError> {
+        Err(SpawnError {
+            error: io::Error::new(
+                io::ErrorKind::Unsupported,
+                "POSIX Exec is not supported on Fuchsia",
+            ),
+            step: Some(SetupStep::Exec),
+        })
+    }
+
+    pub(crate) fn spawn_with(
+        &self,
+        input: SpawnInput,
+        _failure: Option<SetupStep>,
+    ) -> Result<Spawned, SpawnError> {
+        self.spawn(input)
+    }
+}
+
+pub struct Process {
+    termination: Option<Termination>,
+}
+
+impl Process {
+    pub fn cached(&self) -> Option<Termination> {
+        self.termination
+    }
+
+    pub fn try_wait(&mut self) -> io::Result<Option<Termination>> {
+        Ok(self.termination)
+    }
+
+    pub(crate) fn wait_or_park(&mut self, _token: Option<u64>) -> io::Result<Option<Termination>> {
+        Ok(self.termination)
+    }
+
+    pub(crate) fn withdraw_wait(&self) {}
+
+    pub fn signal(&mut self, _signal: Signal) -> io::Result<()> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "POSIX signals are not supported on Fuchsia",
+        ))
+    }
+}
+
+pub(crate) fn probe() -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "POSIX Exec is not supported on Fuchsia",
+    ))
+}
diff --git a/crates/hirsel-core-rt/src/host/fuchsia/file.rs b/crates/hirsel-core-rt/src/host/fuchsia/file.rs
new file mode 100644
index 000000000..c02c787d7
--- /dev/null
+++ b/crates/hirsel-core-rt/src/host/fuchsia/file.rs
@@ -0,0 +1,75 @@
+//! File operations on Fuchsia/Zircon over fdio/libc.
+use std::{io, os::fd::RawFd};
+
+fn checked(rc: isize) -> io::Result<isize> {
+    if rc < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(rc)
+    }
+}
+
+pub(crate) fn write_part(
+    fd: RawFd,
+    bytes: &[u8],
+    offset: Option<i64>,
+    _ring: bool,
+    _align: u64,
+) -> io::Result<usize> {
+    if super::zircon_dir::is_zircon_fd(fd) {
+        return super::zircon_dir::write_part(fd, bytes, offset);
+    }
+    // SAFETY: `fd` and `bytes` remain live through the call.
+    let result = unsafe {
+        let data = bytes.as_ptr().cast();
+        match offset {
+            Some(at) => libc::pwrite(fd, data, bytes.len(), at),
+            None => libc::write(fd, data, bytes.len()),
+        }
+    };
+    checked(result).map(|n| n as usize)
+}
+
+pub(crate) fn close(fd: RawFd) -> io::Result<()> {
+    if super::zircon_dir::is_zircon_fd(fd) {
+        return super::zircon_dir::close(fd);
+    }
+    // SAFETY: consumes the sole owned fd.
+    checked(unsafe { libc::close(fd) } as isize)?;
+    Ok(())
+}
+
+/// # Safety
+/// `data` is writable for `len` bytes, and `fd` remains live until return.
+pub(crate) unsafe fn read_part(
+    fd: RawFd,
+    data: *mut u8,
+    len: usize,
+    offset: Option<u64>,
+    _ring: bool,
+) -> io::Result<isize> {
+    if super::zircon_dir::is_zircon_fd(fd) {
+        return super::zircon_dir::read_part(fd, data, len, offset);
+    }
+    // SAFETY: by the contract.
+    checked(unsafe {
+        match offset {
+            Some(at) => libc::pread(fd, data.cast(), len, at as i64),
+            None => libc::read(fd, data.cast(), len),
+        }
+    })
+}
+
+pub(crate) fn sync(fd: RawFd, directory: bool, _ring: bool) -> io::Result<()> {
+    let rc = if directory {
+        super::sync::sync_directory(fd)
+    } else {
+        super::sync::sync_data(fd)
+    };
+    checked(rc as isize).map(drop)
+}
+
+pub(crate) fn zero_part(fd: RawFd, iov: &[libc::iovec], at: i64, _ring: bool) -> io::Result<usize> {
+    // SAFETY: `fd` and `iov` are live throughout `pwritev`.
+    checked(unsafe { libc::pwritev(fd, iov.as_ptr(), iov.len() as i32, at) }).map(|n| n as usize)
+}
