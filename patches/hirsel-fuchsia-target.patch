+    pub fn bytes(&mut self) -> &mut [u8] {
+        match *self {}
+    }
+    pub fn send(&mut self, _tag: u64, _range: std::ops::Range<usize>) -> io::Result<()> {
+        match *self {}
+    }
+    pub fn state(&self) -> super::TxState {
+        match *self {}
+    }
+    pub fn cancel(&self) {
+        match *self {}
+    }
+}
