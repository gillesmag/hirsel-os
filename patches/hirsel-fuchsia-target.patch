+                // SAFETY: the final run restores exactly the host action saved at entry.
+                unsafe {
+                    libc::sigaction(
+                        libc::SIGPIPE,
+                        &state.previous.take().unwrap_or_else(|| stop(b"Signal")),
+                        std::ptr::null_mut(),
+                    );
+                }
             }
         }
     }
