diff --git a/crates/hirsel-core-rt/src/host/fuchsia/sync.rs b/crates/hirsel-core-rt/src/host/fuchsia/sync.rs
new file mode 100644
index 000000000..b22ce44f7
--- /dev/null
+++ b/crates/hirsel-core-rt/src/host/fuchsia/sync.rs
@@ -0,0 +1,47 @@
+//! Durable sync on Fuchsia/Zircon.
+use crate::provider::{IoError, MODE_DIRECT, MODE_DURABLE, Outcome};
+use std::{
+    io,
+    os::fd::{BorrowedFd, RawFd},
+};
+
+pub(crate) const DURABLE_WRITE: i32 = 0;
+
+#[inline(always)]
+pub(crate) fn sync_data(fd: RawFd) -> i32 {
+    if super::zircon_dir::is_zircon_fd(fd) {
+        return super::zircon_dir::sync(fd);
+    }
+    // SAFETY: the caller holds `fd` open across the call.
+    unsafe { libc::fsync(fd) }
+}
+
+#[inline(always)]
+pub(crate) fn sync_directory(fd: RawFd) -> i32 {
+    if super::zircon_dir::is_zircon_fd(fd) {
+        return super::zircon_dir::sync(fd);
+    }
+    // SAFETY: the caller holds `fd` open across the call.
+    unsafe { libc::fsync(fd) }
+}
+
+pub(crate) fn finish_write(fd: RawFd, mode: u8, out: &mut Outcome) {
+    if !matches!(mode, MODE_DURABLE | MODE_DIRECT) || out.written == 0 {
+        return;
+    }
+    if sync_data(fd) < 0 {
+        let errno = io::Error::last_os_error()
+            .raw_os_error()
+            .unwrap_or(libc::EIO);
+        out.written = 0;
+        out.error = IoError::from_errno(errno);
+    }
+}
+
+pub(crate) fn enable_direct(_fd: BorrowedFd<'_>, _flags: i32) -> io::Result<()> {
+    Ok(())
+}
+
+pub(crate) fn zero_extension(_fd: BorrowedFd<'_>) -> io::Result<bool> {
+    Ok(false)
+}
diff --git a/crates/hirsel-core-rt/src/host/fuchsia/sys.rs b/crates/hirsel-core-rt/src/host/fuchsia/sys.rs
new file mode 100644
index 000000000..b4a16a520
--- /dev/null
+++ b/crates/hirsel-core-rt/src/host/fuchsia/sys.rs
@@ -0,0 +1,228 @@
+//! Low-level host primitives on Fuchsia/Zircon.
+use std::{
+    io,
+    os::fd::{AsRawFd, FromRawFd, IntoRawFd, OwnedFd, RawFd},
+};
+
+#[link(name = "zircon")]
+unsafe extern "C" {
+    fn zx_cprng_draw(buffer: *mut u8, buffer_size: usize);
+}
+
+#[inline(always)]
+pub(crate) fn errno() -> *mut libc::c_int {
+    // SAFETY: returns this thread's errno slot.
+    unsafe { libc::__errno_location() }
+}
+
+pub(crate) const VDISABLE: libc::cc_t = 0;
+
+fn owned(fd: libc::c_int) -> io::Result<OwnedFd> {
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: fresh descriptor.
+    Ok(unsafe { OwnedFd::from_raw_fd(fd) })
+}
+
+pub(crate) struct Notice {
+    fd: OwnedFd,
+}
+
+impl Notice {
+    pub(crate) fn new(nonblocking: bool) -> io::Result<Self> {
+        // Upstream Rust `libc::EFD_CLOEXEC` is mistakenly Linux's 0x80000 on Fuchsia;
+        // Fuchsia's <sys/eventfd.h> defines EFD_CLOEXEC = O_CLOEXEC (0x100).
+        let flags = libc::O_CLOEXEC | if nonblocking { libc::O_NONBLOCK } else { 0 };
+        // SAFETY: creates a fresh eventfd.
+        let fd = owned(unsafe { libc::eventfd(0, flags) })?;
+        Ok(Self { fd })
+    }
+
+    pub(crate) fn reader(&self) -> RawFd {
+        self.fd.as_raw_fd()
+    }
+
+    pub(crate) fn writer(&self) -> RawFd {
+        self.fd.as_raw_fd()
+    }
+}
+
+pub(crate) fn post(writer: RawFd) -> isize {
+    let one: u64 = 1;
+    // SAFETY: 8-byte eventfd write.
+    unsafe { libc::write(writer, (&raw const one).cast(), size_of::<u64>()) }
+}
+
+pub(crate) fn take(reader: RawFd) -> isize {
+    let mut val: u64 = 0;
+    // SAFETY: 8-byte eventfd read.
+    unsafe { libc::read(reader, (&raw mut val).cast(), size_of::<u64>()) }
+}
+
+pub(crate) fn socket(domain: libc::c_int, kind: libc::c_int) -> isize {
+    // SAFETY: creates a fresh socket descriptor.
+    unsafe { libc::socket(domain, kind | libc::SOCK_NONBLOCK | libc::SOCK_CLOEXEC, 0) as isize }
+}
+
+/// # Safety
+/// `address` and `len` are null or a writable address and its length.
+pub(crate) unsafe fn accept(
+    fd: RawFd,
+    address: *mut libc::sockaddr,
+    len: *mut libc::socklen_t,
+) -> isize {
+    // SAFETY: by the contract.
+    let client = unsafe { libc::accept(fd, address, len) };
+    if client < 0 {
+        return -1;
+    }
+    // SAFETY: fresh descriptor.
+    let owned = unsafe { OwnedFd::from_raw_fd(client) };
+    // SAFETY: set CLOEXEC + NONBLOCK.
+    unsafe {
+        let _ = libc::fcntl(client, libc::F_SETFD, libc::FD_CLOEXEC);
+        let flags = libc::fcntl(client, libc::F_GETFL);
+        if flags >= 0 {
+            let _ = libc::fcntl(client, libc::F_SETFL, flags | libc::O_NONBLOCK);
+        }
+    }
+    owned.into_raw_fd() as isize
+}
+
+pub(crate) const PROTOCOL: Option<libc::c_int> = None;
+
+pub(crate) fn socket_domain(fd: RawFd) -> io::Result<libc::c_int> {
+    // SAFETY: zeroed sockaddr_storage.
+    let mut address: libc::sockaddr_storage = unsafe { std::mem::zeroed() };
+    let mut len = size_of::<libc::sockaddr_storage>() as libc::socklen_t;
+    // SAFETY: address and len are live.
+    if unsafe { libc::getsockname(fd, (&raw mut address).cast(), &mut len) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(libc::c_int::from(address.ss_family))
+}
+
+pub(crate) fn listening(fd: RawFd) -> io::Result<bool> {
+    let mut val: libc::c_int = 0;
+    let mut len = size_of::<libc::c_int>() as libc::socklen_t;
+    // SAFETY: SO_ACCEPTCONN writes one int.
+    if unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_SOCKET,
+            libc::SO_ACCEPTCONN,
+            (&raw mut val).cast(),
+            &mut len,
+        )
+    } < 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(val != 0)
+}
+
+/// # Safety
+/// `data` is writable for `room` bytes, or `room` is 0.
+pub(crate) unsafe fn receive_packet(fd: RawFd, data: *mut u8, room: usize) -> isize {
+    let mut iov = libc::iovec {
+        iov_base: data.cast(),
+        iov_len: room,
+    };
+    // SAFETY: zeroed msghdr.
+    let mut msg: libc::msghdr = unsafe { std::mem::zeroed() };
+    msg.msg_iov = &mut iov;
+    msg.msg_iovlen = 1;
+    // SAFETY: by the contract.
+    unsafe { libc::recvmsg(fd, &mut msg, libc::MSG_TRUNC) }
+}
+
+pub(crate) fn peer_uid(_fd: RawFd) -> Option<u32> {
+    None
+}
+
+pub(crate) const PEER_CLOSED: libc::c_short = 0;
+
+pub(crate) const RANDOM_NOWAIT: u32 = 1;
+
+/// Fill `len` bytes from Zircon's kernel CSPRNG (`zx_cprng_draw`).
+///
+/// # Safety
+/// `data` is writable for `len` bytes.
+pub(crate) unsafe fn random(data: *mut u8, len: usize, _flags: u32) -> isize {
+    // SAFETY: `zx_cprng_draw` never fails and writes `len` cryptographically random bytes.
+    unsafe { zx_cprng_draw(data, len) };
+    len as isize
+}
+
+pub(crate) fn timer() -> io::Result<OwnedFd> {
+    // SAFETY: creates a monotonic timerfd.
+    let fd = owned(unsafe {
+        libc::timerfd_create(libc::CLOCK_MONOTONIC, libc::TFD_NONBLOCK | libc::TFD_CLOEXEC)
+    })?;
+    let spec = libc::itimerspec {
+        it_interval: libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 1_000_000,
+        },
+        it_value: libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 1_000_000,
+        },
+    };
+    // SAFETY: `fd` and `spec` are live.
+    if unsafe { libc::timerfd_settime(fd.as_raw_fd(), 0, &spec, std::ptr::null_mut()) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(fd)
+}
+
+pub(crate) fn tick(fd: RawFd) -> isize {
+    let mut count: u64 = 0;
+    // SAFETY: 8-byte timerfd read.
+    unsafe { libc::read(fd, (&raw mut count).cast(), size_of::<u64>()) }
+}
+
+pub(crate) fn exit_with_parent(_expected: libc::pid_t) -> io::Result<()> {
+    Ok(())
+}
+
+pub(crate) fn udp_queue_bytes() -> Option<u64> {
+    None
+}
+
+pub(crate) fn activation_pid() -> u32 {
+    0
+}
+
+pub(crate) fn running_image(_fd: RawFd) -> io::Result<bool> {
+    Ok(false)
+}
+
+/// # Safety
+/// Caller owns `[start, start + bytes)`, which holds no live data.
+#[inline]
+pub(crate) unsafe fn discard(start: usize, bytes: usize) -> bool {
+    // SAFETY: by the contract.
+    unsafe { libc::madvise(std::ptr::without_provenance_mut(start), bytes, libc::MADV_DONTNEED) == 0 }
+}
+
+/// # Safety
+/// Caller owns `[start, start + bytes)`, which holds no live data.
+#[inline]
+pub(crate) unsafe fn decommit(start: usize, bytes: usize) -> bool {
+    // SAFETY: by the contract.
+    unsafe {
+        libc::madvise(
+            std::ptr::without_provenance_mut(start),
+            bytes,
+            libc::MADV_DONTNEED,
+        ) == 0
+    }
+}
+
+pub(crate) const INHERITED_STORE: &[u8] = b"";
+
+pub(crate) fn page_map() -> Option<std::fs::File> {
+    None
+}
