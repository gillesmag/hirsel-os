+//! Confined opens and Unix sockets on Fuchsia/Zircon.
+use std::{
+    ffi::CStr,
+    io,
+    os::{
+        fd::{AsRawFd, BorrowedFd, FromRawFd, OwnedFd},
+        unix::net::UnixStream,
+    },
+};
+
+pub(crate) const DIRECTORY: i32 = libc::O_RDONLY | libc::O_DIRECTORY;
+
+pub(crate) fn open_beneath(root: BorrowedFd<'_>, path: &CStr, flags: i32) -> io::Result<OwnedFd> {
+    let flags = flags | libc::O_CLOEXEC | libc::O_NOFOLLOW;
+    // SAFETY: `path` is NUL-terminated and live for the call.
+    let fd = unsafe { libc::openat(root.as_raw_fd(), path.as_ptr(), flags, 0) };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: openat returned an owned descriptor.
+    Ok(unsafe { OwnedFd::from_raw_fd(fd) })
+}
+
+pub(crate) fn isolate_binding_thread(_dir: BorrowedFd<'_>) -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "AF_UNIX path binding is not supported on Fuchsia",
+    ))
+}
+
+pub(crate) fn bind_in(_socket: BorrowedFd<'_>, _dir: BorrowedFd<'_>, _leaf: &CStr) -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "AF_UNIX path binding is not supported on Fuchsia",
+    ))
+}
+
+pub(crate) fn connect_pinned(_dir: BorrowedFd<'_>, _leaf: &CStr) -> io::Result<UnixStream> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "AF_UNIX pinned connect is not supported on Fuchsia",
+    ))
+}
