diff --git a/crates/hirsel-core-net/src/reactor/fuchsia.rs b/crates/hirsel-core-net/src/reactor/fuchsia.rs
new file mode 100644
index 000000000..afca35cef
--- /dev/null
+++ b/crates/hirsel-core-net/src/reactor/fuchsia.rs
@@ -0,0 +1,422 @@
+//! The Fuchsia/Zircon readiness provider: backs [`crate::ready`] and
+//! [`Poller`] using `poll(2)` + `eventfd(2)` (via Zircon/fdio).
+use super::{Backend, POLL_BATCH, PollEvents, PollOperations, Poller, Turn, WAKE, checked};
+use crate::ready::{Event, Ready, Trigger};
+use std::{
+    collections::HashMap,
+    io,
+    marker::PhantomData,
+    mem::ManuallyDrop,
+    os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd},
+    sync::{Arc, Mutex, OnceLock},
+};
+
+#[derive(Clone, Copy)]
+pub(crate) struct RawEvent {
+    token: u64,
+    ready: u32,
+}
+
+/// A wake is the selector's `eventfd` descriptor.
+pub(crate) type WakerId = RawFd;
+
+/// A selector's level-triggered wake source.
+pub(crate) struct WakeSource {
+    wake_fd: RawFd,
+}
+
+/// Child handle placeholder on Fuchsia.
+#[derive(Clone, Copy, Debug)]
+pub struct Child<'a>(u32, PhantomData<&'a ()>);
+
+impl Child<'_> {
+    pub fn new(handle: u32) -> Self {
+        Self(handle, PhantomData)
+    }
+}
+
+pub(crate) const READABLE: u32 = 1;
+pub(crate) const WRITABLE: u32 = 2;
+pub(crate) const READ_CLOSED: u32 = 4;
+pub(crate) const HANG_UP: u32 = 8;
+pub(crate) const ERROR: u32 = 16;
+pub(crate) const CHANGED: u32 = 32;
+
+pub(super) const INTEREST: u32 = READABLE | WRITABLE | READ_CLOSED;
+
+pub(crate) const fn raw_event(token: u64, ready: u32) -> RawEvent {
+    RawEvent { token, ready }
+}
+
+#[inline(always)]
+pub(crate) fn token(event: &RawEvent) -> u64 {
+    event.token
+}
+
+#[inline(always)]
+pub(crate) fn ready(event: &RawEvent) -> u32 {
+    event.ready
+}
+
+#[derive(Clone, Copy)]
+struct Watch {
+    fd: RawFd,
+    token: u64,
+    interest: u32,
+    oneshot: bool,
+}
+
+#[derive(Default)]
+struct PollSet {
+    watches: Vec<Watch>,
+    wake_token: Option<u64>,
+}
+
+static SETS: OnceLock<Mutex<HashMap<RawFd, Arc<Mutex<PollSet>>>>> = OnceLock::new();
+
+fn sets() -> &'static Mutex<HashMap<RawFd, Arc<Mutex<PollSet>>>> {
+    SETS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+fn get_set(selector_fd: RawFd) -> io::Result<Arc<Mutex<PollSet>>> {
+    sets()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get(&selector_fd)
+        .cloned()
+        .ok_or_else(|| io::Error::from_raw_os_error(libc::EBADF))
+}
+
+pub(crate) fn selector() -> io::Result<OwnedFd> {
+    // SAFETY: creates a fresh nonblocking close-on-exec eventfd that also
+    // serves as this selector's wake handle and map key.
+    let fd = checked(unsafe { libc::eventfd(0, libc::EFD_NONBLOCK | libc::EFD_CLOEXEC) })?;
+    // SAFETY: eventfd transferred ownership of `fd`.
+    let owned = unsafe { OwnedFd::from_raw_fd(fd) };
+    sets()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(owned.as_raw_fd(), Arc::new(Mutex::new(PollSet::default())));
+    Ok(owned)
+}
+
+fn interest_to_poll(interest: u32) -> i16 {
+    let mut events: i16 = 0;
+    if interest & READABLE != 0 {
+        events |= libc::POLLIN;
+    }
+    if interest & WRITABLE != 0 {
+        events |= libc::POLLOUT;
+    }
+    if interest & CHANGED != 0 {
+        events |= libc::POLLPRI;
+    }
+    events
+}
+
+fn revents_to_ready(revents: i16) -> u32 {
+    let mut out = 0;
+    if revents & libc::POLLIN != 0 {
+        out |= READABLE;
+    }
+    if revents & libc::POLLOUT != 0 {
+        out |= WRITABLE;
+    }
+    if revents & libc::POLLHUP != 0 {
+        out |= HANG_UP | READ_CLOSED;
+    }
+    if revents & (libc::POLLERR | libc::POLLNVAL) != 0 {
+        out |= ERROR;
+    }
+    if revents & libc::POLLPRI != 0 {
+        out |= CHANGED;
+    }
+    out
+}
+
+pub(crate) fn wait(
+    selector_fd: RawFd,
+    events: &mut [Event],
+    timeout_ns: Option<u64>,
+) -> io::Result<usize> {
+    let set = get_set(selector_fd)?;
+    let (mut fds, meta, wake_token) = {
+        let guard = set.lock().unwrap_or_else(|e| e.into_inner());
+        let mut fds = Vec::with_capacity(guard.watches.len() + 1);
+        let mut meta = Vec::with_capacity(guard.watches.len());
+        if guard.wake_token.is_some() {
+            fds.push(libc::pollfd {
+                fd: selector_fd,
+                events: libc::POLLIN,
+                revents: 0,
+            });
+        }
+        for w in &guard.watches {
+            fds.push(libc::pollfd {
+                fd: w.fd,
+                events: interest_to_poll(w.interest),
+                revents: 0,
+            });
+            meta.push(*w);
+        }
+        (fds, meta, guard.wake_token)
+    };
+
+    let timeout_ms: i32 = match timeout_ns {
+        None => -1,
+        Some(0) => 0,
+        Some(ns) => ((ns.saturating_add(999_999)) / 1_000_000)
+            .min(i32::MAX as u64) as i32,
+    };
+
+    // SAFETY: `fds` is live for the duration of `poll`.
+    let rc = unsafe { libc::poll(fds.as_mut_ptr(), fds.len() as libc::nfds_t, timeout_ms) };
+    if rc < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if rc == 0 {
+        return Ok(0);
+    }
+
+    let mut written = 0usize;
+    let mut offset = 0usize;
+    if let Some(wtoken) = wake_token {
+        offset = 1;
+        if fds[0].revents & libc::POLLIN != 0 && written < events.len() {
+            events[written] = Event::new(wtoken, Ready::READABLE);
+            written += 1;
+        }
+    }
+
+    let mut remove_oneshot = Vec::new();
+    for (pfd, watch) in fds[offset..].iter().zip(meta.iter()) {
+        if pfd.revents == 0 {
+            continue;
+        }
+        if written >= events.len() {
+            break;
+        }
+        events[written] = Event::new(watch.token, Ready(revents_to_ready(pfd.revents)));
+        written += 1;
+        if watch.oneshot {
+            remove_oneshot.push(watch.fd);
+        }
+    }
+
+    if !remove_oneshot.is_empty() {
+        let mut guard = set.lock().unwrap_or_else(|e| e.into_inner());
+        guard.watches.retain(|w| !remove_oneshot.contains(&w.fd));
+    }
+
+    Ok(written)
+}
+
+pub(crate) fn add(
+    selector_fd: RawFd,
+    fd: RawFd,
+    token: u64,
+    interest: u32,
+    trigger: Trigger,
+) -> io::Result<()> {
+    let set = get_set(selector_fd)?;
+    let mut guard = set.lock().unwrap_or_else(|e| e.into_inner());
+    guard.watches.retain(|w| w.fd != fd);
+    guard.watches.push(Watch {
+        fd,
+        token,
+        interest,
+        oneshot: matches!(trigger, Trigger::Once),
+    });
+    Ok(())
+}
+
+pub(crate) fn modify(
+    selector_fd: RawFd,
+    fd: RawFd,
+    token: u64,
+    interest: u32,
+) -> io::Result<()> {
+    add(selector_fd, fd, token, interest, Trigger::Level)
+}
+
+pub(crate) fn remove(selector_fd: RawFd, fd: RawFd) -> io::Result<()> {
+    if let Ok(set) = get_set(selector_fd) {
+        let mut guard = set.lock().unwrap_or_else(|e| e.into_inner());
+        guard.watches.retain(|w| w.fd != fd);
+    }
+    Ok(())
+}
+
+pub(crate) fn add_exit(_selector_fd: RawFd, _child: Child<'_>, _token: u64) -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "POSIX child exit wait is not supported on Fuchsia",
+    ))
+}
+
+pub(crate) fn wake_source(selector_fd: RawFd, token: u64) -> io::Result<WakeSource> {
+    let set = get_set(selector_fd)?;
+    set.lock().unwrap_or_else(|e| e.into_inner()).wake_token = Some(token);
+    Ok(WakeSource {
+        wake_fd: selector_fd,
+    })
+}
+
+pub(crate) fn waker_id(source: &WakeSource) -> WakerId {
+    source.wake_fd
+}
+
+pub(crate) fn wake(wake_fd: WakerId) {
+    let one: u64 = 1;
+    // SAFETY: writing 8 bytes to a nonblocking eventfd.
+    unsafe {
+        libc::write(wake_fd, (&raw const one).cast(), size_of::<u64>());
+    }
+}
+
+pub(crate) fn reset(source: &WakeSource) {
+    let mut buf: u64 = 0;
+    // SAFETY: draining 8 bytes from a nonblocking eventfd.
+    unsafe {
+        libc::read(source.wake_fd, (&raw mut buf).cast(), size_of::<u64>());
+    }
+}
+
+impl Poller {
+    pub(super) fn new_readiness() -> io::Result<Arc<Self>> {
+        let fd = selector()?;
+        let _ = wake_source(fd.as_raw_fd(), WAKE)?;
+        Ok(Arc::new(Self {
+            backend: Backend::Fuchsia { selector: fd },
+            udp_groups: ManuallyDrop::new(OnceLock::new()),
+            udp_budget: Mutex::default(),
+            udp_deferred: ManuallyDrop::default(),
+            events: Mutex::new(Vec::with_capacity(POLL_BATCH as usize)),
+            operations: &PollOperations {
+                poll: Self::poll_fuchsia,
+                wake: Self::wake_fuchsia,
+                add: Self::add_fuchsia,
+                remove: Self::remove_fuchsia,
+                release: |poller| {
+                    let Backend::Fuchsia { selector } = &poller.backend;
+                    sets()
+                        .lock()
+                        .unwrap_or_else(|e| e.into_inner())
+                        .remove(&selector.as_raw_fd());
+                    poller.release_udp();
+                },
+            },
+        }))
+    }
+
+    fn selector_fd(&self) -> RawFd {
+        let Backend::Fuchsia { selector } = &self.backend;
+        selector.as_raw_fd()
+    }
+
+    fn add_fuchsia(&self, fd: &Arc<OwnedFd>, tag: u64, _owner: bool) -> io::Result<()> {
+        add(self.selector_fd(), fd.as_raw_fd(), tag, INTEREST, Trigger::Level)
+    }
+
+    fn remove_fuchsia(&self, fd: i32, _tag: u64, _closing: bool, _owner: bool) -> io::Result<()> {
+        remove(self.selector_fd(), fd)
+    }
+
+    fn poll_fuchsia<'a>(
+        &'a self,
+        mut events: Turn<'a>,
+        timeout_ns: Option<u64>,
+    ) -> io::Result<Option<PollEvents<'a>>> {
+        events.clear();
+        events.resize(POLL_BATCH as usize, Event::EMPTY);
+        crate::EPOLL_WAITS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let len = match wait(self.selector_fd(), &mut events, timeout_ns) {
+            Ok(n) => n,
+            Err(e) if e.kind() == io::ErrorKind::Interrupted => {
+                events.clear();
+                return Ok(None);
+            }
+            Err(e) => {
+                events.clear();
+                return Err(e);
+            }
+        };
+        events.truncate(len);
+        // Drain wake eventfd if woken.
+        if events.iter().any(|e| e.token() == WAKE) {
+            reset(&WakeSource {
+                wake_fd: self.selector_fd(),
+            });
+        }
+        let visible = self.dispatch_udp_slot(&mut events);
+        Ok(Some(PollEvents(events, visible)))
+    }
+
+    pub(super) fn waker_id(&self) -> WakerId {
+        self.selector_fd()
+    }
+
+    fn wake_fuchsia(&self) {
+        wake(self.waker_id());
+    }
+
+    pub fn wait_slot(&self, out: &mut [Event], timeout_ns: Option<u64>) -> io::Result<usize> {
+        let _turn = self.events.lock().unwrap_or_else(|e| e.into_inner());
+        let timeout_ns = if self.udp_due() { Some(0) } else { timeout_ns };
+        let len = wait(self.selector_fd(), out, timeout_ns)?;
+        if out[..len].iter().any(|e| e.token() == WAKE) {
+            reset(&WakeSource {
+                wake_fd: self.selector_fd(),
+            });
+        }
+        Ok(self.dispatch_udp_slot(&mut out[..len]))
+    }
+
+    pub fn due(&self) -> bool {
+        self.udp_due()
+    }
+
+    /// # Safety
+    /// No `FileEntry` exists on Fuchsia.
+    pub unsafe fn submit_file(
+        &self,
+        _unit: u32,
+        entry: FileEntry,
+        _context: *const (),
+        _complete: unsafe fn(*const (), i32),
+    ) -> bool {
+        match entry {}
+    }
+
+    pub fn tx_slot(self: &Arc<Self>, _len: usize) -> Option<TxSlot> {
+        None
+    }
+
+    pub fn tx_notifications(&self) -> (u64, u64) {
+        (0, 0)
+    }
+}
+
+pub enum FileEntry {}
+pub enum TxSlot {}
+
+impl TxSlot {
