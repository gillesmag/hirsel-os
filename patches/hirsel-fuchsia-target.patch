diff --git a/crates/hirsel-core-rt/src/host/fuchsia/path.rs b/crates/hirsel-core-rt/src/host/fuchsia/path.rs
new file mode 100644
index 000000000..adafb2c06
--- /dev/null
+++ b/crates/hirsel-core-rt/src/host/fuchsia/path.rs
@@ -0,0 +1,104 @@
+//! Confined opens on Fuchsia/Zircon.
+use std::{
+    ffi::CStr,
+    io,
+    os::fd::{FromRawFd, OwnedFd, RawFd},
+};
+
+pub(crate) const DIRECTORY_HANDLE: i32 = libc::O_RDONLY | libc::O_DIRECTORY;
+pub(crate) const LEAF_HANDLE: i32 = libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_NONBLOCK;
+
+#[derive(Clone, Copy)]
+pub(crate) enum Refuse {
+    MagicLinks,
+    Symlinks,
+}
+
+pub(crate) struct How {
+    flags: i32,
+    mode: libc::c_uint,
+}
+
+pub(crate) fn how(flags: i32, refuse: Refuse) -> How {
+    How {
+        flags: flags
+            | libc::O_CLOEXEC
+            | match refuse {
+                Refuse::MagicLinks => 0,
+                Refuse::Symlinks => libc::O_NOFOLLOW,
+            },
+        mode: if flags & libc::O_CREAT != 0 { 0o600 } else { 0 },
+    }
+}
+
+pub(crate) fn open_beneath(fd: RawFd, path: &CStr, how: &How) -> io::Result<OwnedFd> {
+    if super::zircon_dir::is_zircon_fd(fd) {
+        return super::zircon_dir::open_beneath(fd, path, how.flags);
+    }
+    // SAFETY: `path` is NUL-terminated and live for the call.
+    let raw = unsafe { libc::openat(fd, path.as_ptr(), how.flags, how.mode) };
+    if raw < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: `openat` returned a fresh descriptor.
+    Ok(unsafe { OwnedFd::from_raw_fd(raw) })
+}
+
+fn checked(rc: libc::c_int) -> io::Result<()> {
+    if rc < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+pub(crate) fn leaf_mode(parent: RawFd, name: &CStr) -> io::Result<Option<libc::mode_t>> {
+    if super::zircon_dir::is_zircon_fd(parent) {
+        return super::zircon_dir::leaf_mode(name);
+    }
+    let mut st = std::mem::MaybeUninit::<libc::stat>::uninit();
+    // SAFETY: `parent` and `name` are live; final symlink is not followed.
+    let rc = unsafe {
+        libc::fstatat(
+            parent,
+            name.as_ptr(),
+            st.as_mut_ptr(),
+            libc::AT_SYMLINK_NOFOLLOW,
+        )
+    };
+    match checked(rc) {
+        // SAFETY: `fstatat` initialized `st`.
+        Ok(()) => Ok(Some(unsafe { st.assume_init() }.st_mode & libc::S_IFMT)),
+        Err(error) if error.raw_os_error() == Some(libc::ENOENT) => Ok(None),
+        Err(error) => Err(error),
+    }
+}
+
+pub(crate) fn rename_at(
+    from: RawFd,
+    from_name: &CStr,
+    to: RawFd,
+    to_name: &CStr,
+) -> io::Result<()> {
+    if super::zircon_dir::is_zircon_fd(from) || super::zircon_dir::is_zircon_fd(to) {
+        return super::zircon_dir::rename(from_name, to_name);
+    }
+    // SAFETY: pinned parents and NUL-terminated leaves.
+    checked(unsafe { libc::renameat(from, from_name.as_ptr(), to, to_name.as_ptr()) })
+}
+
+pub(crate) fn mkdir_at(parent: RawFd, name: &CStr, mode: libc::mode_t) -> io::Result<()> {
+    if super::zircon_dir::is_zircon_fd(parent) {
+        return super::zircon_dir::mkdir(name);
+    }
+    // SAFETY: pinned parent and NUL-terminated leaf.
+    checked(unsafe { libc::mkdirat(parent, name.as_ptr(), mode) })
+}
+
+pub(crate) fn unlink_at(parent: RawFd, name: &CStr, flags: i32) -> io::Result<()> {
+    if super::zircon_dir::is_zircon_fd(parent) {
+        return super::zircon_dir::unlink(name);
+    }
+    // SAFETY: pinned parent and NUL-terminated leaf.
+    checked(unsafe { libc::unlinkat(parent, name.as_ptr(), flags) })
+}
