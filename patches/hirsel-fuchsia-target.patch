+//! AF_UNIX endpoint pinning stub on Fuchsia/Zircon.
+use std::{io, os::fd::OwnedFd};
+
+pub(crate) struct Endpoint;
+
+impl Endpoint {
+    pub(crate) fn pin(_parent: OwnedFd, _name: &str) -> io::Result<Self> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "AF_UNIX endpoints are not supported on Fuchsia",
+        ))
+    }
+
+    pub(crate) fn identity(&self) -> io::Result<(u64, u64)> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "AF_UNIX endpoints are not supported on Fuchsia",
+        ))
+    }
+}
+
+pub(crate) fn reach<R>(
+    _endpoint: &Endpoint,
+    _call: impl FnOnce(&[u8]) -> Result<R, i32>,
+) -> Result<R, i32> {
+    Err(libc::ENOTSUP)
+}
diff --git a/crates/hirsel-core-rt/src/host/fuchsia/zircon_dir.rs b/crates/hirsel-core-rt/src/host/fuchsia/zircon_dir.rs
new file mode 100644
index 000000000..216c27fac
--- /dev/null
+++ b/crates/hirsel-core-rt/src/host/fuchsia/zircon_dir.rs
@@ -0,0 +1,260 @@
+//! Zircon-channel `Dir` capability client for shell-less Hirsel-OS Tier 1 Jobs.
+//!
+//! When `hirsel-init` launches a Tier 1 Hirsel process with `grant_dir = true`,
+//! it passes a Zircon channel handle at `PA_HND(PA_USER0, 1)`. Operations on the
+//! synthetic descriptor range `fd >= ZIRCON_FD_BASE` are marshaled synchronously
+//! via `zx_channel_call` to `hirsel-init`'s `virtio-blk`-backed persistent store.
+
+use std::{
+    ffi::CStr,
+    io,
+    os::fd::{FromRawFd, OwnedFd, RawFd},
+    ptr,
+    sync::OnceLock,
+};
+
+pub(crate) const ZIRCON_FD_BASE: RawFd = 0x1000_0000;
+const PA_USER0_DIR: u32 = 0xF0 | (1 << 16); // PA_HND(PA_USER0, 1)
+const ZX_HANDLE_INVALID: u32 = 0;
+const ZX_OK: i32 = 0;
+const ZX_TIME_INFINITE: i64 = i64::MAX;
+
+pub(crate) const OP_OPEN_ROOT: u32 = 1;
+pub(crate) const OP_OPEN: u32 = 2;
+pub(crate) const OP_READ: u32 = 3;
+pub(crate) const OP_WRITE: u32 = 4;
+pub(crate) const OP_STAT: u32 = 5;
+pub(crate) const OP_STAT_PATH: u32 = 6;
+pub(crate) const OP_SYNC: u32 = 7;
+pub(crate) const OP_CLOSE: u32 = 8;
+pub(crate) const OP_UNLINK: u32 = 9;
+pub(crate) const OP_RENAME: u32 = 10;
+pub(crate) const OP_MKDIR: u32 = 11;
+
+const REQ_HDR_LEN: usize = 28;
+const RESP_HDR_LEN: usize = 36;
+
+#[repr(C)]
+struct ZxChannelCallArgs {
+    wr_bytes: *const u8,
+    wr_handles: *const u32,
+    rd_bytes: *mut u8,
+    rd_handles: *mut u32,
+    wr_num_bytes: u32,
+    wr_num_handles: u32,
+    rd_num_bytes: u32,
+    rd_num_handles: u32,
+}
+
+#[link(name = "zircon")]
+unsafe extern "C" {
+    fn zx_channel_call(
+        handle: u32,
+        options: u32,
+        deadline: i64,
+        args: *const ZxChannelCallArgs,
+        actual_bytes: *mut u32,
+        actual_handles: *mut u32,
+    ) -> i32;
+}
+
+unsafe extern "C" {
+    fn zx_take_startup_handle(id: u32) -> u32;
+}
+
+static DIR_CHANNEL: OnceLock<u32> = OnceLock::new();
+
+fn dir_channel() -> Option<u32> {
+    let h = *DIR_CHANNEL.get_or_init(|| unsafe { zx_take_startup_handle(PA_USER0_DIR) });
+    if h == ZX_HANDLE_INVALID { None } else { Some(h) }
+}
+
+#[inline]
+pub(crate) fn is_zircon_fd(fd: RawFd) -> bool {
+    fd >= ZIRCON_FD_BASE
+}
+
+#[inline]
+fn fd_to_id(fd: RawFd) -> u32 {
+    (fd - ZIRCON_FD_BASE) as u32
+}
+
+struct RpcReply {
+    arg0: u32,
+    arg1: u32,
+    val0: u64,
+    val1: i64,
+    payload: Vec<u8>,
+}
+
+fn rpc_call(op: u32, arg0: u32, arg1: u32, offset: i64, payload: &[u8]) -> io::Result<RpcReply> {
+    let ch = dir_channel().ok_or_else(|| io::Error::from_raw_os_error(libc::EACCES))?;
+    let mut wr = Vec::with_capacity(REQ_HDR_LEN + payload.len());
+    wr.extend_from_slice(&0u32.to_le_bytes()); // txid filled by Zircon kernel
+    wr.extend_from_slice(&op.to_le_bytes());
+    wr.extend_from_slice(&arg0.to_le_bytes());
+    wr.extend_from_slice(&arg1.to_le_bytes());
+    wr.extend_from_slice(&offset.to_le_bytes());
+    wr.extend_from_slice(&(payload.len() as u32).to_le_bytes());
+    wr.extend_from_slice(payload);
+
+    let mut rd = vec![0u8; 65536];
+    let args = ZxChannelCallArgs {
+        wr_bytes: wr.as_ptr(),
+        wr_handles: ptr::null(),
+        rd_bytes: rd.as_mut_ptr(),
+        rd_handles: ptr::null_mut(),
+        wr_num_bytes: wr.len() as u32,
+        wr_num_handles: 0,
+        rd_num_bytes: rd.len() as u32,
+        rd_num_handles: 0,
+    };
+    let mut actual_bytes = 0u32;
+    let mut actual_handles = 0u32;
+    let st = unsafe {
+        zx_channel_call(
+            ch,
+            0,
+            ZX_TIME_INFINITE,
+            &args,
+            &mut actual_bytes,
+            &mut actual_handles,
+        )
+    };
+    if st != ZX_OK || (actual_bytes as usize) < RESP_HDR_LEN {
+        return Err(io::Error::from_raw_os_error(libc::EIO));
+    }
+    let errno = i32::from_le_bytes(rd[4..8].try_into().unwrap());
+    if errno != 0 {
+        return Err(io::Error::from_raw_os_error(errno));
+    }
+    let r_arg0 = u32::from_le_bytes(rd[8..12].try_into().unwrap());
+    let r_arg1 = u32::from_le_bytes(rd[12..16].try_into().unwrap());
+    let val0 = u64::from_le_bytes(rd[16..24].try_into().unwrap());
+    let val1 = i64::from_le_bytes(rd[24..32].try_into().unwrap());
+    let plen = u32::from_le_bytes(rd[32..36].try_into().unwrap()) as usize;
+    let end = (RESP_HDR_LEN + plen).min(actual_bytes as usize);
+    Ok(RpcReply {
+        arg0: r_arg0,
+        arg1: r_arg1,
+        val0,
+        val1,
+        payload: rd[RESP_HDR_LEN..end].to_vec(),
+    })
+}
+
+/// Attempts to bind the Zircon-channel root `Dir` capability if `hirsel-init` granted one.
+pub(crate) fn try_open_root() -> io::Result<Option<OwnedFd>> {
+    if dir_channel().is_none() {
+        return Ok(None);
+    }
+    let _ = rpc_call(OP_OPEN_ROOT, 0, 0, 0, &[])?;
+    // SAFETY: synthetic descriptor in `ZIRCON_FD_BASE..`, intercepted by host/fuchsia/*.rs.
+    Ok(Some(unsafe { OwnedFd::from_raw_fd(ZIRCON_FD_BASE) }))
+}
+
+pub(crate) fn open_beneath(_parent: RawFd, path: &CStr, flags: i32) -> io::Result<OwnedFd> {
+    let bytes = path.to_bytes();
+    if bytes == b"." || bytes.is_empty() {
+        return Ok(unsafe { OwnedFd::from_raw_fd(ZIRCON_FD_BASE) });
+    }
+    let acc = flags & libc::O_ACCMODE;
+    let mut wire_flags: u32 = 0;
+    if acc == libc::O_RDONLY || acc == libc::O_RDWR {
+        wire_flags |= 1 << 0; // READ
+    }
+    if acc == libc::O_WRONLY || acc == libc::O_RDWR {
+        wire_flags |= 1 << 1; // WRITE
+    }
+    if (flags & libc::O_CREAT) != 0 {
+        wire_flags |= 1 << 2; // CREAT
+    }
+    if (flags & libc::O_EXCL) != 0 {
+        wire_flags |= 1 << 3; // EXCL
+    }
+    if (flags & libc::O_TRUNC) != 0 {
+        wire_flags |= 1 << 4; // TRUNC
+    }
+    if (flags & libc::O_APPEND) != 0 {
+        wire_flags |= 1 << 5; // APPEND
+    }
+    let r = rpc_call(OP_OPEN, wire_flags, 0, 0, bytes)?;
+    let fd = ZIRCON_FD_BASE + (r.arg0 as RawFd);
+    Ok(unsafe { OwnedFd::from_raw_fd(fd) })
+}
+
+pub(crate) fn read_part(fd: RawFd, dst: *mut u8, len: usize, offset: Option<u64>) -> io::Result<isize> {
+    let req_len = len.min(60_000) as u32;
+    let off = offset.map_or(-1i64, |v| v as i64);
+    let r = rpc_call(OP_READ, fd_to_id(fd), req_len, off, &[])?;
+    let n = r.payload.len().min(len);
+    if n > 0 {
+        unsafe { ptr::copy_nonoverlapping(r.payload.as_ptr(), dst, n) };
+    }
+    Ok(n as isize)
+}
+
+pub(crate) fn write_part(fd: RawFd, bytes: &[u8], offset: Option<i64>) -> io::Result<usize> {
+    let chunk = &bytes[..bytes.len().min(60_000)];
+    let off = offset.unwrap_or(-1);
+    let r = rpc_call(OP_WRITE, fd_to_id(fd), 0, off, chunk)?;
+    Ok(r.arg0 as usize)
+}
+
+pub(crate) fn close(fd: RawFd) -> io::Result<()> {
+    let id = fd_to_id(fd);
+    if id == 0 {
+        return Ok(());
+    }
+    let _ = rpc_call(OP_CLOSE, id, 0, 0, &[])?;
+    Ok(())
+}
+
+pub(crate) fn sync(fd: RawFd) -> i32 {
+    match rpc_call(OP_SYNC, fd_to_id(fd), 0, 0, &[]) {
+        Ok(_) => 0,
+        Err(e) => {
+            unsafe { *super::sys::errno() = e.raw_os_error().unwrap_or(libc::EIO) };
+            -1
+        }
+    }
+}
+
+pub(crate) fn fstat(fd: RawFd) -> io::Result<libc::stat> {
+    let r = rpc_call(OP_STAT, fd_to_id(fd), 0, 0, &[])?;
+    let mut st: libc::stat = unsafe { std::mem::zeroed() };
+    st.st_size = r.val0 as libc::off_t;
+    st.st_mode = r.arg0 as libc::mode_t;
+    st.st_mtime = (r.val1 / 1_000_000_000) as libc::time_t;
+    st.st_mtime_nsec = (r.val1 % 1_000_000_000) as libc::c_long;
+    let _ = r.arg1;
+    Ok(st)
+}
+
+pub(crate) fn leaf_mode(name: &CStr) -> io::Result<Option<libc::mode_t>> {
+    match rpc_call(OP_STAT_PATH, 0, 0, 0, name.to_bytes()) {
+        Ok(r) => Ok(Some((r.arg0 as libc::mode_t) & libc::S_IFMT)),
+        Err(e) if e.raw_os_error() == Some(libc::ENOENT) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+
+pub(crate) fn unlink(name: &CStr) -> io::Result<()> {
+    let _ = rpc_call(OP_UNLINK, 0, 0, 0, name.to_bytes())?;
+    Ok(())
+}
+
+pub(crate) fn rename(from: &CStr, to: &CStr) -> io::Result<()> {
+    let fb = from.to_bytes();
+    let tb = to.to_bytes();
+    let mut payload = Vec::with_capacity(fb.len() + tb.len());
+    payload.extend_from_slice(fb);
+    payload.extend_from_slice(tb);
+    let _ = rpc_call(OP_RENAME, fb.len() as u32, 0, 0, &payload)?;
+    Ok(())
+}
+
+pub(crate) fn mkdir(name: &CStr) -> io::Result<()> {
+    let _ = rpc_call(OP_MKDIR, 0, 0, 0, name.to_bytes())?;
+    Ok(())
+}
