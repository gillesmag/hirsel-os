# Hirsel-OS Desktop Bazel Product Assembly:
#   - Patched Zircon kernel (AMD SVM + NPT + native virtio-gpu-display / sysmem / Scenic Flatland)
#   - Native Chromium 160.0.8155.0 (//src/chromium:web_engine) directly on Zircon/Flatland
#   - Pure-Hirsel Window Manager & Security Policy Brain (hirsel-wm) + Rust Flatland Presenter (hirsel-shell)

load("@fuchsia_build_info//:args.bzl", "build_info_version")
load(
    "@rules_fuchsia//fuchsia:assembly.bzl",
    "ARCH",
    "BUILD_TYPES",
    "fuchsia_elf_sizes",
    "fuchsia_prebuilt_package",
    "fuchsia_product",
    "fuchsia_product_bundle",
    "fuchsia_product_configuration",
    "fuchsia_virtual_device",
)
load("//build/info:info.bzl", "DEFAULT_PRODUCT_BUILD_INFO")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = [
        "//build/bazel/assembly:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)

fuchsia_product_bundle(
    name = "product_bundle.x64",
    default_virtual_device = ":hirsel_emu",
    main = ":assembly.x64",
    product_bundle_name = "hirsel_desktop.x64",
    recovery = "//products/zedboot:x64",
    repository_keys = "//src/sys/pkg/repositories/devhost/keys",
    update_epoch = "1",
    virtual_devices = [
        ":hirsel_emu",
    ],
)

fuchsia_product(
    name = "assembly.x64",
    board_config = "//boards:x64",
    platform_artifacts = "//build/bazel/assembly/assembly_input_bundles:platform_eng",
    product_config = ":assembly_config",
)

fuchsia_elf_sizes(
    name = "elf_sizes.x64",
    product = ":assembly.x64",
)

fuchsia_virtual_device(
    name = "hirsel_emu",
    arch = ARCH.X64,
    audio_model = "hda",
    cpu_count = 4,
    description = "Hirsel-OS Desktop QEMU/KVM virtual workstation (1280x800, 4 GiB RAM)",
    device_name = "hirsel_emu",
    input_device = "mouse",
    memory_quantity = 4096,
    window_height_px = 800,
    window_width_px = 1280,
)

fuchsia_product_configuration(
    name = "assembly_config",
    base_packages = [
        "//src/fonts/asset_providers:small-open-fonts-collection",
    ],
    cache_packages = [
        ":hirsel_session",
        "//src/chromium:web_engine",
    ],
    product_config_json = {
        "platform": {
            "build_type": BUILD_TYPES.ENG,
            "connectivity": {
                "network": {
                    "netcfg_config_path": "LABEL(//src/connectivity/policy/netcfg/config:netcfg_default.json5)",
                    "include_tun": True,
                    "netstack_multi_vmo": True,
                    "netstack_tcp_gro_enabled": True,
                },
            },
            "development_support": {
                "tools": {
                    "display": {
                        "driver_tools": True,
                    },
                    "connectivity": {
                        "enable_networking": True,
                    },
                },
            },
            "fonts": {
                "font_collection": "small-open-fonts-collection",
            },
            "graphics": {
                "virtual_console": {
                    "enable": False,
                },
            },
            "media": {
                "audio": {
                    "full_stack": {},
                },
                "enable_codecs": True,
                "enable_sessions": True,
            },
            "session": {
                "enabled": True,
            },
            "ui": {
                "display_composition": True,
                "enabled": True,
                "supported_input_devices": [
                    "button",
                    "keyboard",
                    "mouse",
                    "touchscreen",
                ],
                "with_synthetic_device_support": True,
            },
            "kernel": {
                "scheduler_enable_new_wakeup_accounting": True,
            },
        },
        "product": {
            "session": {
                "url": "fuchsia-pkg://fuchsia.com/hirsel_session#meta/hirsel_session.cm",
            },
            "build_info": DEFAULT_PRODUCT_BUILD_INFO | {
                "name": "hirsel_desktop",
            },
        },
    },
    version = build_info_version,
)

fuchsia_prebuilt_package(
    name = "hirsel_session",
    archive = "@gn_targets//products/hirsel_desktop/hirsel_session:hirsel_session_archive",
)
