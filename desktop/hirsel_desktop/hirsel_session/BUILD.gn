# Hirsel-OS Desktop Session package:
#   - hirsel_session.cm: root session realm hosting hirsel_shell + isolated egress_gw + web_engine context_provider
#   - egress_gw.cm: isolated Fuchsia component owning sealed Fxfs secret vault + TLS 1.3 HTTPS outbound gateway
#   - hirsel_shell: thin Rust Flatland presenter, Chromium 160 launcher, trusted chrome painter
#   - bin/hirsel-wm: pure-Hirsel deterministic window manager & security policy brain
#   - bin/hirsel-board: pure-Hirsel Figments spatial board state Place (std.model.explore verified)
#   - bin/hirsel-agent: pure-Hirsel autonomous agent planner Place (std.model.explore verified)
#   - bin/hirsel-js: pure-Hirsel Figments js@1 deterministic JS sandbox Place
#   - bin/hirsel-vm-host + data/vm/*: real Tier-2 Linux 6.1.102 AMD-SVM MicroVM host for vm-dev

import("//build/bazel/bazel_inputs.gni")
import("//build/components.gni")
import("//build/components/fuchsia_package_archive.gni")
import("//build/dist/resource.gni")
import("//build/rust/rustc_binary.gni")

resource("hirsel_wm_bin") {
  sources = [ "prebuilt/hirsel-wm" ]
  outputs = [ "bin/hirsel-wm" ]
  allow_binary_output_dir = true
}

resource("hirsel_board_bin") {
  sources = [ "prebuilt/hirsel-board" ]
  outputs = [ "bin/hirsel-board" ]
  allow_binary_output_dir = true
}

resource("hirsel_agent_bin") {
  sources = [ "prebuilt/hirsel-agent" ]
  outputs = [ "bin/hirsel-agent" ]
  allow_binary_output_dir = true
}

resource("hirsel_js_bin") {
  sources = [ "prebuilt/hirsel-js" ]
  outputs = [ "bin/hirsel-js" ]
  allow_binary_output_dir = true
}

resource("hirsel_vm_host_bin") {
  sources = [ "prebuilt/hirsel-vm-host" ]
  outputs = [ "bin/hirsel-vm-host" ]
  allow_binary_output_dir = true
}

resource("vm_linux_kernel") {
  sources = [ "prebuilt/vm/vmlinux.stripped" ]
  outputs = [ "data/vm/vmlinux.stripped" ]
}

resource("vm_linux_initrd") {
  sources = [ "prebuilt/vm/initramfs-ssh.cpio" ]
  outputs = [ "data/vm/initramfs-ssh.cpio" ]
}

rustc_binary("egress_gw_bin") {
  output_name = "egress_gw"
  edition = "2024"
  source_root = "src/egress_gw.rs"
  sources = [ "src/egress_gw.rs" ]
  deps = [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rustls",
    "//third_party/rust_crates:rustls-pemfile",
    "//third_party/rust_crates:serde_json",
  ]
}

rustc_binary("hirsel_shell_bin") {
  output_name = "hirsel_shell"
  edition = "2024"
  source_root = "src/main.rs"
  sources = [
    "src/agent_client.rs",
    "src/board_client.rs",
    "src/font8x16.rs",
    "src/js_client.rs",
    "src/main.rs",
    "src/painter.rs",
    "src/vm_client.rs",
    "src/web_content.rs",
    "src/wm_client.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
    "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
    "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
    "//sdk/fidl/fuchsia.session.scene:fuchsia.session.scene_rust",
    "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust",
    "//sdk/fidl/fuchsia.ui.composition:fuchsia.ui.composition_rust",
    "//sdk/fidl/fuchsia.ui.input3:fuchsia.ui.input3_rust",
    "//sdk/fidl/fuchsia.ui.pointer:fuchsia.ui.pointer_rust",
    "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_rust",
    "//sdk/fidl/fuchsia.web:fuchsia.web_rust",
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//src/lib/fuchsia-runtime",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
  ]
}

fuchsia_component_manifest("hirsel_session_manifest") {
  manifest = "meta/hirsel_session.cml"
  component_name = "hirsel_session"
}

fuchsia_component("hirsel_session_component") {
  cm_label = ":hirsel_session_manifest"
}

fuchsia_component_manifest("egress_gw_manifest") {
  manifest = "meta/egress_gw.cml"
  component_name = "egress_gw"
}

fuchsia_component("egress_gw_component") {
  cm_label = ":egress_gw_manifest"
  deps = [ ":egress_gw_bin" ]
}

fuchsia_component_manifest("hirsel_shell_manifest") {
  manifest = "meta/hirsel_shell.cml"
  component_name = "hirsel_shell"
}

fuchsia_component("hirsel_shell_component") {
  cm_label = ":hirsel_shell_manifest"
  deps = [
    ":hirsel_agent_bin",
    ":hirsel_board_bin",
    ":hirsel_js_bin",
    ":hirsel_shell_bin",
    ":hirsel_vm_host_bin",
    ":hirsel_wm_bin",
    ":vm_linux_initrd",
    ":vm_linux_kernel",
  ]
}

fuchsia_package("hirsel_session") {
  package_name = "hirsel_session"
  deps = [
    ":egress_gw_component",
    ":hirsel_session_component",
    ":hirsel_shell_component",
  ]
}

fuchsia_package_archive("hirsel_session_archive") {
  package = ":hirsel_session"
}

bazel_input_file("hirsel_session_bazel_inputs") {
  generator = ":hirsel_session_archive"
}
