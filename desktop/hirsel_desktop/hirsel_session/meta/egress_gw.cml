// Isolated Egress Gateway & Sealed Secret Vault Component (egress_gw.cm).
// Exposes ONLY the private FIDL protocol `hirsel.egress.Gateway` (ZERO TCP listening sockets!).
// Owns its own isolated Fxfs /data secret store + root-ssl-certificates for TLS 1.3 HTTPS.
{
    include: [
        "//sdk/lib/inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/egress_gw",
    },
    capabilities: [
        { protocol: "fuchsia.hirsel.egress.Gateway" },
    ],
    use: [
        {
            protocol: [
                "fuchsia.net.name.Lookup",
                "fuchsia.posix.socket.Provider",
            ],
        },
        {
            directory: "root-ssl-certificates",
            rights: [ "r*" ],
            path: "/config/ssl",
            availability: "optional",
        },
        {
            storage: "data",
            path: "/data",
            availability: "optional",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.hirsel.egress.Gateway",
            from: "self",
        },
    ],
}
